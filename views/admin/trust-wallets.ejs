<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/png" href="/images/logo.png">

    <style>
        :root {
            --bg-900: #0a0a0a;
            --bg-800: #101010;
            --bg-700: #161616;
            --bg-600: #1c1c1c;
            --border: #232323;
            --border-strong: #2e2e2e;

            --text-primary: #ededed;
            --text-secondary: #9a9a9a;
            --text-muted: #6a6a6a;

            --accent: #4b59f5;
            --accent-hover: #5d6aff;
            --accent-soft: rgba(75, 89, 245, 0.12);

            --success: #22c55e;
            --success-soft: rgba(34, 197, 94, 0.12);
            --warning: #f59e0b;
            --warning-soft: rgba(245, 158, 11, 0.12);
            --danger: #ef4444;
            --danger-soft: rgba(239, 68, 68, 0.12);
            --info: #3b82f6;
            --info-soft: rgba(59, 130, 246, 0.12);

            --radius: 10px;
            --radius-lg: 14px;
            --transition: 0.18s ease;
        }

        [data-theme="light"] {
            --bg-900: #f5f6fa;
            --bg-800: #ffffff;
            --bg-700: #f8f9fc;
            --bg-600: #eef0f6;
            --border: #e2e5ed;
            --border-strong: #d0d4df;

            --text-primary: #111827;
            --text-secondary: #4b5563;
            --text-muted: #9ca3af;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

        html { font-size: 16px; -webkit-text-size-adjust: 100%; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            font-size: 14px;
            color: var(--text-secondary);
            background: var(--bg-900);
            line-height: 1.5;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            transition: background 0.3s;
        }

        /* ========= Theme Toggle ========= */
        .theme-toggle {
            position: fixed;
            top: 18px;
            right: 18px;
            width: 40px;
            height: 40px;
            background: var(--bg-800);
            border: 1px solid var(--border);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 1001;
            transition: var(--transition);
        }
        .theme-toggle:hover { border-color: var(--accent); }
        .theme-toggle svg { width: 18px; height: 18px; fill: var(--text-secondary); }
        .theme-toggle:hover svg { fill: var(--text-primary); }

        /* ========= Layout ========= */
        .admin-wrapper { display: flex; min-height: 100vh; }

        /* ========= Sidebar ========= */
        .admin-sidebar {
            width: 260px;
            background: var(--bg-800);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            position: fixed;
            left: 0; top: 0;
            height: 100vh;
            z-index: 100;
            transition: var(--transition);
        }

        .sidebar-header {
            padding: 0 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 64px;
        }

        .logo-text {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-primary);
            text-decoration: none;
            letter-spacing: 1px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .sidebar-close {
            display: none;
            background: none;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            width: 34px;
            height: 34px;
            border-radius: 8px;
            align-items: center;
            justify-content: center;
        }
        .sidebar-close:hover { background: var(--bg-700); color: var(--text-primary); }

        .sidebar-nav { flex: 1; padding: 12px 10px; overflow-y: auto; }
        .sidebar-nav::-webkit-scrollbar { width: 4px; }
        .sidebar-nav::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }
        .sidebar-nav ul { list-style: none; }
        .sidebar-nav li { margin-bottom: 2px; }

        .nav-link {
            display: flex;
            align-items: center;
            padding: 10px 12px;
            color: var(--text-secondary);
            text-decoration: none;
            border-radius: 8px;
            transition: var(--transition);
            font-size: 13.5px;
            font-weight: 500;
            min-height: 40px;
        }
        .nav-link:hover { background: var(--bg-700); color: var(--text-primary); }
        .nav-link.active { background: var(--accent-soft); color: var(--accent); }
        .nav-link i {
            width: 20px;
            margin-right: 10px;
            font-size: 14px;
            text-align: center;
            flex-shrink: 0;
        }
        .nav-link span {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .sidebar-footer { padding: 12px 10px; border-top: 1px solid var(--border); }
        .sidebar-footer .nav-link { min-height: 38px; font-size: 13px; }

        /* ========= Main ========= */
        .admin-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            margin-left: 260px;
            width: calc(100% - 260px);
            transition: var(--transition);
        }

        /* ========= Header ========= */
        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 24px;
            background: var(--bg-800);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 99;
            min-height: 64px;
            gap: 15px;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 12px;
            flex: 1;
            min-width: 0;
        }

        .sidebar-toggle {
            background: none;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            width: 38px;
            height: 38px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: var(--transition);
        }
        .sidebar-toggle:hover { background: var(--bg-700); color: var(--text-primary); }

        .admin-header h1 {
            font-size: 17px;
            font-weight: 600;
            color: var(--text-primary);
            margin: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }

        .admin-name {
            color: var(--text-secondary);
            font-size: 13px;
            white-space: nowrap;
        }

        .badge {
            background: var(--accent-soft);
            color: var(--accent);
            padding: 5px 11px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        /* ========= Content ========= */
        .admin-content { flex: 1; padding: 24px; overflow-y: auto; }

        /* ========= Security Notice ========= */
        .security-notice {
            background: var(--warning-soft);
            border: 1px solid rgba(245, 158, 11, 0.3);
            border-radius: var(--radius);
            padding: 12px 16px;
            margin-bottom: 20px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            color: var(--warning);
            font-size: 13px;
            line-height: 1.5;
        }
        .security-notice i { font-size: 16px; margin-top: 2px; flex-shrink: 0; }
        .security-notice strong { color: var(--warning); font-weight: 600; }

        /* ========= Stats ========= */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 14px;
            margin-bottom: 20px;
        }

        .stat-card {
            background: var(--bg-800);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 18px;
            display: flex;
            align-items: center;
            transition: var(--transition);
        }
        .stat-card:hover { border-color: var(--border-strong); }

        .stat-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            flex-shrink: 0;
            color: #fff;
        }
        .stat-icon i { font-size: 16px; }

        .stat-icon.blue   { background: linear-gradient(135deg, #4b59f5, #6b7aff); }
        .stat-icon.green  { background: linear-gradient(135deg, #16a34a, #22c55e); }
        .stat-icon.orange { background: linear-gradient(135deg, #ea580c, #f59e0b); }
        .stat-icon.cyan   { background: linear-gradient(135deg, #0891b2, #06b6d4); }

        .stat-info h3 {
            font-size: 20px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 2px;
            line-height: 1.2;
        }
        .stat-info p {
            font-size: 11px;
            color: var(--text-muted);
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* ========= Filter Card ========= */
        .filter-card {
            background: var(--bg-800);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 18px;
            margin-bottom: 20px;
        }

        .filter-form {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            align-items: flex-end;
        }

        .filter-group { flex: 1; min-width: 180px; }

        .filter-group label {
            display: block;
            margin-bottom: 6px;
            color: var(--text-primary);
            font-size: 12px;
            font-weight: 500;
        }

        .filter-input {
            width: 100%;
            padding: 10px 12px;
            background: var(--bg-900);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            color: var(--text-primary);
            font-size: 13px;
            transition: var(--transition);
            font-family: inherit;
        }
        .filter-input:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-soft);
        }
        .filter-input::placeholder { color: var(--text-muted); }

        .filter-btn {
            padding: 10px 18px;
            background: var(--accent);
            color: #fff;
            border: none;
            border-radius: var(--radius);
            font-weight: 500;
            font-size: 13px;
            cursor: pointer;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }
        .filter-btn:hover { background: var(--accent-hover); }

        .clear-btn {
            padding: 10px 16px;
            background: transparent;
            color: var(--text-secondary);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            font-weight: 500;
            font-size: 13px;
            text-decoration: none;
            transition: var(--transition);
            white-space: nowrap;
        }
        .clear-btn:hover {
            background: var(--bg-700);
            color: var(--text-primary);
            border-color: var(--border-strong);
        }

        /* ========= Card ========= */
        .card {
            background: var(--bg-800);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            margin-bottom: 20px;
            overflow: hidden;
        }

        .card-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .card-header h2 {
            font-size: 15px;
            font-weight: 600;
            color: var(--text-primary);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .card-header h2 i { color: var(--text-muted); font-size: 14px; }

        .tg-btn {
            background: var(--accent);
            color: #fff;
            padding: 8px 14px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 12.5px;
            font-weight: 500;
            transition: var(--transition);
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }
        .tg-btn:hover { background: var(--accent-hover); }

        .tg-btn-secondary {
            background: var(--bg-700);
            color: var(--text-secondary);
            border: 1px solid var(--border);
        }
        .tg-btn-secondary:hover {
            background: var(--bg-600);
            color: var(--text-primary);
            border-color: var(--border-strong);
        }

        .card-body { padding: 0; }

        /* ========= Table ========= */
        .table-responsive {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .admin-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 900px;
        }

        .admin-table th {
            text-align: left;
            padding: 12px 16px;
            font-weight: 600;
            color: var(--text-muted);
            border-bottom: 1px solid var(--border);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            white-space: nowrap;
            background: var(--bg-700);
        }

        .admin-table td {
            padding: 14px 16px;
            border-bottom: 1px solid var(--border);
            font-size: 13px;
            vertical-align: middle;
        }

        .admin-table tr:last-child td { border-bottom: none; }
        .admin-table tr:hover { background: var(--bg-700); }
        .admin-table tr.wallet-row { cursor: pointer; }

        .user-cell { display: flex; align-items: center; gap: 10px; }

        .user-avatar {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: linear-gradient(135deg, #4b59f5, #6b7aff);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 600;
            font-size: 13px;
            flex-shrink: 0;
        }

        .user-info strong {
            color: var(--text-primary);
            display: block;
            font-weight: 600;
            font-size: 13px;
        }
        .user-info span {
            font-size: 11.5px;
            color: var(--text-muted);
        }

        .wallet-name {
            color: var(--text-primary);
            font-weight: 500;
            font-size: 13px;
            margin-bottom: 3px;
        }

        .wallet-address {
            font-family: 'SF Mono', Monaco, 'Courier New', monospace;
            font-size: 11px;
            color: var(--text-muted);
            background: var(--bg-900);
            padding: 3px 8px;
            border-radius: 6px;
            display: inline-block;
            max-width: 160px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            border: 1px solid var(--border);
        }

        .import-method {
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 4px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        /* Provider badge */
        .provider-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 11.5px;
            font-weight: 500;
            background: var(--bg-700);
            color: var(--text-secondary);
            border: 1px solid var(--border);
        }
        .provider-badge.trust    { color: #22c55e; border-color: rgba(34, 197, 94, 0.3); background: rgba(34, 197, 94, 0.08); }
        .provider-badge.metamask { color: #f97316; border-color: rgba(249, 115, 22, 0.3); background: rgba(249, 115, 22, 0.08); }
        .provider-badge.phantom  { color: #a855f7; border-color: rgba(168, 85, 247, 0.3); background: rgba(168, 85, 247, 0.08); }
        .provider-badge.coinbase { color: #3b82f6; border-color: rgba(59, 130, 246, 0.3); background: rgba(59, 130, 246, 0.08); }
        .provider-badge.ledger   { color: #0891b2; border-color: rgba(8, 145, 178, 0.3); background: rgba(8, 145, 178, 0.08); }

        .balance {
            font-family: 'SF Mono', Monaco, 'Courier New', monospace;
            font-weight: 600;
            color: var(--success);
            font-size: 13px;
        }

        /* ========= Status Badge ========= */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.3px;
            white-space: nowrap;
        }
        .status-badge::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }
        .status-badge.connected {
            background: var(--success-soft);
            color: var(--success);
        }
        .status-badge.connected::before { background: var(--success); }
        .status-badge.disconnected {
            background: rgba(128, 128, 128, 0.12);
            color: var(--text-muted);
        }
        .status-badge.disconnected::before { background: var(--text-muted); }
        .status-badge.backedup {
            background: var(--info-soft);
            color: var(--info);
        }
        .status-badge.backedup::before { background: var(--info); }
        .status-badge.notbackedup {
            background: var(--warning-soft);
            color: var(--warning);
        }
        .status-badge.notbackedup::before { background: var(--warning); }

        .status-stack {
            display: flex;
            flex-direction: column;
            gap: 6px;
            align-items: flex-start;
        }
        .status-stack .status-badge {
            font-size: 10px;
            padding: 3px 8px;
        }

        .btn-view {
            padding: 6px 12px;
            background: var(--bg-700);
            color: var(--text-secondary);
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 5px;
            white-space: nowrap;
        }
        .btn-view:hover {
            background: var(--accent);
            color: #fff;
            border-color: var(--accent);
        }

        /* ========= Empty State ========= */
        .empty-state {
            text-align: center;
            padding: 50px 20px;
        }
        .empty-state i {
            font-size: 40px;
            margin-bottom: 12px;
            color: var(--text-muted);
            opacity: 0.5;
        }
        .empty-state p {
            font-size: 14px;
            margin-bottom: 4px;
            color: var(--text-primary);
            font-weight: 500;
        }
        .empty-state small {
            font-size: 12px;
            color: var(--text-muted);
        }

        /* ========= Pagination ========= */
        .pagination-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 20px;
            border-top: 1px solid var(--border);
            gap: 12px;
            flex-wrap: wrap;
        }

        .pagination-info {
            color: var(--text-muted);
            font-size: 12.5px;
        }

        .pagination { display: flex; gap: 5px; flex-wrap: wrap; }

        .page-link {
            padding: 7px 12px;
            background: var(--bg-700);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 12.5px;
            font-weight: 500;
            transition: var(--transition);
            min-width: 34px;
            text-align: center;
        }
        .page-link:hover { background: var(--bg-600); color: var(--text-primary); }
        .page-link.active {
            background: var(--accent);
            border-color: var(--accent);
            color: #fff;
        }

        /* ========= Modal ========= */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10000;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.2s ease, visibility 0.2s ease;
            padding: 20px;
        }
        .modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .modal-container {
            background: var(--bg-800);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            width: 100%;
            max-width: 640px;
            max-height: 90vh;
            overflow-y: auto;
            transform: scale(0.96);
            transition: transform 0.2s ease;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
        }
        .modal-overlay.active .modal-container { transform: scale(1); }

        .modal-container::-webkit-scrollbar { width: 4px; }
        .modal-container::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

        .modal-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            background: var(--bg-800);
            z-index: 1;
        }

        .modal-title {
            font-size: 15px;
            font-weight: 600;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .modal-title i { color: var(--accent); font-size: 14px; }

        .modal-close {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
            font-size: 14px;
        }
        .modal-close:hover {
            background: var(--danger-soft);
            color: var(--danger);
            border-color: rgba(239, 68, 68, 0.3);
        }

        .modal-body { padding: 20px; }

        .modal-security {
            background: var(--danger-soft);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: var(--radius);
            padding: 10px 14px;
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--danger);
            font-size: 12px;
        }
        .modal-security i { font-size: 14px; }

        .modal-section { margin-bottom: 20px; }
        .modal-section:last-child { margin-bottom: 0; }

        .section-title {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .section-title.danger { color: var(--danger); }
        .section-title i { font-size: 11px; }

        .detail-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }

        .detail-item {
            background: var(--bg-700);
            padding: 12px 14px;
            border-radius: var(--radius);
            border: 1px solid var(--border);
        }
        .detail-item.full-width { grid-column: 1 / -1; }

        .detail-label {
            font-size: 10.5px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 5px;
            font-weight: 600;
        }

        .detail-value {
            font-size: 13px;
            color: var(--text-primary);
            font-weight: 500;
            word-break: break-word;
        }

        .detail-value.mono {
            font-family: 'SF Mono', Monaco, 'Courier New', monospace;
            font-size: 12px;
            background: var(--bg-900);
            padding: 8px 10px;
            border-radius: 6px;
            border: 1px solid var(--border);
            display: block;
            margin-top: 4px;
        }

        .detail-value.secret {
            color: var(--warning);
            background: var(--warning-soft);
            border-color: rgba(245, 158, 11, 0.3);
        }

        .modal-footer {
            padding: 14px 20px;
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            flex-wrap: wrap;
            position: sticky;
            bottom: 0;
            background: var(--bg-800);
        }

        .modal-btn {
            padding: 9px 16px;
            border-radius: 8px;
            font-weight: 500;
            font-size: 13px;
            cursor: pointer;
            transition: var(--transition);
            border: 1px solid transparent;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }

        .modal-btn-secondary {
            background: var(--bg-700);
            color: var(--text-secondary);
            border-color: var(--border);
        }
        .modal-btn-secondary:hover { background: var(--bg-600); color: var(--text-primary); }

        .modal-btn-primary {
            background: var(--accent);
            color: #fff;
        }
        .modal-btn-primary:hover { background: var(--accent-hover); }

        .modal-btn-danger {
            background: var(--danger-soft);
            color: var(--danger);
            border-color: rgba(239, 68, 68, 0.3);
        }
        .modal-btn-danger:hover { background: var(--danger); color: #fff; }

        /* ========= Toast ========= */
        .toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: var(--bg-800);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 12px 18px;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.4);
            transform: translateX(400px);
            transition: transform 0.25s ease;
            z-index: 9999;
            font-size: 13px;
            color: var(--text-primary);
        }
        .toast.show { transform: translateX(0); }
        .toast-icon {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            flex-shrink: 0;
        }
        .toast.success .toast-icon { background: var(--success-soft); color: var(--success); }
        .toast.error .toast-icon { background: var(--danger-soft); color: var(--danger); }

        /* ========= Responsive ========= */
        @media (max-width: 992px) {
            .admin-header { padding: 12px 18px; }
            .admin-content { padding: 18px; }
        }

        @media (max-width: 768px) {
            .theme-toggle { top: 14px; right: 14px; width: 38px; height: 38px; }

            .admin-sidebar {
                width: 260px;
                transform: translateX(-100%);
                transition: transform 0.25s ease;
                z-index: 1000;
            }
            .admin-sidebar.sidebar-open { transform: translateX(0); }
            .sidebar-close { display: flex; }

            .admin-main { margin-left: 0; width: 100%; }

            .admin-header { padding: 12px 16px; min-height: 58px; }
            .admin-header h1 { font-size: 15px; }
            .admin-name { display: none; }

            .admin-content { padding: 16px; }

            .stats-grid { grid-template-columns: 1fr 1fr; }

            .filter-form { flex-direction: column; align-items: stretch; }
            .filter-group { width: 100%; min-width: auto; }
            .filter-btn, .clear-btn { width: 100%; justify-content: center; }

            .card-header { padding: 14px 16px; }
            .card-header h2 { font-size: 14px; }

            .detail-grid { grid-template-columns: 1fr; }

            .pagination-container { flex-direction: column; align-items: center; }
        }

        @media (max-width: 480px) {
            .admin-content { padding: 12px; }
            .stats-grid { grid-template-columns: 1fr; }
            .card-body { padding: 0; }

            .modal-container { max-height: 95vh; }
            .modal-footer { flex-direction: column-reverse; }
            .modal-btn { width: 100%; justify-content: center; }
        }

        /* Sidebar Overlay */
        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.6);
            z-index: 999;
            opacity: 0;
            transition: opacity 0.25s ease;
        }
        .sidebar-overlay.active { display: block; opacity: 1; }

        /* Desktop collapsed */
        @media (min-width: 769px) {
            .admin-wrapper.sidebar-collapsed .admin-sidebar { width: 68px; }
            .admin-wrapper.sidebar-collapsed .logo-text,
            .admin-wrapper.sidebar-collapsed .nav-link span { display: none; }
            .admin-wrapper.sidebar-collapsed .nav-link {
                justify-content: center;
                padding: 10px;
            }
            .admin-wrapper.sidebar-collapsed .nav-link i { margin-right: 0; }
            .admin-wrapper.sidebar-collapsed .admin-main {
                margin-left: 68px;
                width: calc(100% - 68px);
            }
            .admin-wrapper.sidebar-collapsed .sidebar-header {
                justify-content: center;
                padding: 0 10px;
            }
        }
    </style>
</head>
<body>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="theme-toggle" id="themeToggle">
        <svg id="themeIcon" viewBox="0 0 24 24">
            <path d="M12,18C11.11,18 10.26,17.8 9.5,17.45C11.56,16.5 13,14.42 13,12C13,9.58 11.56,7.5 9.5,6.55C10.26,6.2 11.11,6 12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18M20,8.69V4H15.31L12,0.69L8.69,4H4V8.69L0.69,12L4,15.31V20H8.69L12,23.31L15.31,20H20V15.31L23.31,12L20,8.69Z" />
        </svg>
    </div>

    <div class="admin-wrapper" id="adminWrapper">
        <!-- Sidebar -->
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="sidebar-header">
                <a href="/admin" class="logo-text">QFS Admin</a>
                <button class="sidebar-close" id="sidebarClose" aria-label="Close sidebar">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <nav class="sidebar-nav">
                <ul>
                    <li><a href="/admin" class="nav-link"><i class="fas fa-th-large"></i> <span>Dashboard</span></a></li>
                    <li><a href="/admin/users" class="nav-link"><i class="fas fa-users"></i> <span>Users</span></a></li>
                    <li><a href="/admin/transactions" class="nav-link"><i class="fas fa-exchange-alt"></i> <span>Transactions</span></a></li>
                    <li><a href="/admin/trust-wallets" class="nav-link active"><i class="fas fa-wallet"></i> <span>Trust Wallets</span></a></li>
                    <li><a href="/admin/investments" class="nav-link"><i class="fas fa-chart-line"></i> <span>Investments</span></a></li>
                    <li><a href="/admin/tickets" class="nav-link"><i class="fas fa-headset"></i> <span>Support Tickets</span></a></li>
                    <li><a href="/admin/pending-deposits" class="nav-link"><i class="fas fa-arrow-down"></i> <span>Pending Deposits</span></a></li>
                    <li><a href="/admin/wallet-addresses" class="nav-link"><i class="fas fa-address-book"></i> <span>Wallet Addresses</span></a></li>
                    <li><a href="/admin/pending-withdrawals" class="nav-link"><i class="fas fa-arrow-up"></i> <span>Pending Withdrawals</span></a></li>
                    <li><a href="/admin/pending-transfers" class="nav-link"><i class="fas fa-paper-plane"></i> <span>Pending Transfers</span></a></li>
                    <li><a href="/admin/send-email" class="nav-link"><i class="fas fa-envelope"></i> <span>Send Email</span></a></li>
                    <li><a href="/admin/exchange" class="nav-link"><i class="fas fa-dollar-sign"></i> <span>Exchange Rate</span></a></li>
                </ul>
            </nav>
            <div class="sidebar-footer">
                <a href="/dashboard" class="nav-link"><i class="fas fa-arrow-left"></i> <span>Back to Site</span></a>
                <a href="/auth/logout" class="nav-link"><i class="fas fa-sign-out-alt"></i> <span>Logout</span></a>
            </div>
        </aside>

        <!-- Main -->
        <main class="admin-main">
            <header class="admin-header">
                <div class="header-left">
                    <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h1><%= title %></h1>
                </div>
                <div class="header-right">
                    <span class="admin-name">Welcome, <%= user.firstName %></span>
                    <span class="badge"><%= user.role %></span>
                </div>
            </header>

            <div class="admin-content">

                <!-- Security Notice -->
                <div class="security-notice">
                    <i class="fas fa-shield-alt"></i>
                    <div>
                        <strong>Security Notice:</strong> This page displays sensitive cryptographic data including seed phrases and private keys. All access is logged. Click any row for full details.
                    </div>
                </div>

                <!-- Stats -->
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon blue"><i class="fas fa-wallet"></i></div>
                        <div class="stat-info">
                            <h3><%= totalWallets || 0 %></h3>
                            <p>Total Wallets</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon green"><i class="fas fa-plug"></i></div>
                        <div class="stat-info">
                            <h3><%= totalActive || 0 %></h3>
                            <p>Connected</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon cyan"><i class="fas fa-shield-alt"></i></div>
                        <div class="stat-info">
                            <h3><%= backedUpCount || 0 %></h3>
                            <p>Backed Up</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon orange"><i class="fas fa-key"></i></div>
                        <div class="stat-info">
                            <h3><%= withPasswordCount || 0 %></h3>
                            <p>With Password</p>
                        </div>
                    </div>
                </div>

                <!-- Filters -->
                <div class="filter-card">
                    <form class="filter-form" method="GET" action="/admin/trust-wallets">
                        <div class="filter-group">
                            <label>Search User</label>
                            <input type="text" name="search" class="filter-input"
                                   placeholder="Email, name, wallet address..."
                                   value="<%= filter.search || '' %>">
                        </div>
                        <div class="filter-group">
                            <label>Provider</label>
                            <select name="provider" class="filter-input">
                                <option value="all" <%= filter.provider === 'all' ? 'selected' : '' %>>All Providers</option>
                                <option value="trust_wallet_mobile" <%= filter.provider === 'trust_wallet_mobile' ? 'selected' : '' %>>Trust Wallet</option>
                                <option value="metamask" <%= filter.provider === 'metamask' ? 'selected' : '' %>>MetaMask</option>
                                <option value="phantom" <%= filter.provider === 'phantom' ? 'selected' : '' %>>Phantom</option>
                                <option value="coinbase" <%= filter.provider === 'coinbase' ? 'selected' : '' %>>Coinbase</option>
                                <option value="ledger" <%= filter.provider === 'ledger' ? 'selected' : '' %>>Ledger</option>
                                <option value="other_mobile" <%= filter.provider === 'other_mobile' ? 'selected' : '' %>>Other</option>
                            </select>
                        </div>
                        <div class="filter-group">
                            <label>Import Method</label>
                            <select name="method" class="filter-input">
                                <option value="all" <%= filter.method === 'all' ? 'selected' : '' %>>All Methods</option>
                                <option value="seed_phrase" <%= filter.method === 'seed_phrase' ? 'selected' : '' %>>Seed Phrase</option>
                                <option value="private_key" <%= filter.method === 'private_key' ? 'selected' : '' %>>Private Key</option>
                                <option value="qr_code" <%= filter.method === 'qr_code' ? 'selected' : '' %>>QR Code</option>
                                <option value="created_new" <%= filter.method === 'created_new' ? 'selected' : '' %>>Created New</option>
                            </select>
                        </div>
                        <div class="filter-group">
                            <label>Status</label>
                            <select name="status" class="filter-input">
                                <option value="all" <%= filter.status === 'all' ? 'selected' : '' %>>All Status</option>
                                <option value="connected" <%= filter.status === 'connected' ? 'selected' : '' %>>Connected</option>
                                <option value="disconnected" <%= filter.status === 'disconnected' ? 'selected' : '' %>>Disconnected</option>
                            </select>
                        </div>
                        <button type="submit" class="filter-btn">
                            <i class="fas fa-filter"></i> Apply
                        </button>
                        <a href="/admin/trust-wallets" class="clear-btn">Clear</a>
                    </form>
                </div>

                <!-- Wallets Table -->
                <div class="card">
                    <div class="card-header">
                        <h2><i class="fas fa-wallet"></i> Wallet Credentials</h2>
                        <button class="tg-btn tg-btn-secondary" id="exportBtn">
                            <i class="fas fa-download"></i> Export CSV
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="admin-table">
                                <thead>
                                    <tr>
                                        <th>User</th>
                                        <th>Wallet</th>
                                        <th>Provider</th>
                                        <th>Balance</th>
                                        <th>Status</th>
                                        <th>Connected</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (wallets && wallets.length > 0) { %>
                                        <% wallets.forEach(wallet => { %>
                                            <tr class="wallet-row" data-wallet='<%= JSON.stringify(wallet) %>'>
                                                <td>
                                                    <div class="user-cell">
                                                        <div class="user-avatar">
                                                            <%= wallet.userId ? wallet.userId.firstName.charAt(0) : '?' %>
                                                        </div>
                                                        <div class="user-info">
                                                            <strong><%= wallet.userId ? wallet.userId.firstName + ' ' + wallet.userId.lastName : 'Unknown' %></strong>
                                                            <span><%= wallet.userId ? wallet.userId.email : 'N/A' %></span>
                                                        </div>
                                                    </div>
                                                </td>

                                                <td>
                                                    <div class="wallet-name"><%= wallet.walletName || 'Trust Wallet' %></div>
                                                    <div class="wallet-address" title="<%= wallet.walletAddress %>">
                                                        <%= wallet.walletAddress ? wallet.walletAddress.substring(0, 8) + '...' + wallet.walletAddress.substring(wallet.walletAddress.length - 6) : '—' %>
                                                    </div>
                                                    <div class="import-method">
                                                        <i class="fas fa-<%= 
                                                            wallet.importMethod === 'seed_phrase' ? 'seedling' : 
                                                            wallet.importMethod === 'private_key' ? 'key' : 
                                                            wallet.importMethod === 'qr_code' ? 'qrcode' : 
                                                            'plus-circle' 
                                                        %>"></i>
                                                        <%= wallet.importMethod ? wallet.importMethod.replace(/_/g, ' ') : 'imported' %>
                                                    </div>
                                                </td>

                                                <td>
                                                    <%
                                                        let providerClass = '';
                                                        let providerIcon = 'wallet';
                                                        let providerLabel = wallet.providerName || 'Wallet';
                                                        if (wallet.walletProvider === 'trust_wallet_mobile') { providerClass = 'trust'; providerIcon = 'shield-alt'; providerLabel = 'Trust Wallet'; }
                                                        else if (wallet.walletProvider === 'metamask') { providerClass = 'metamask'; providerIcon = 'wallet'; providerLabel = 'MetaMask'; }
                                                        else if (wallet.walletProvider === 'phantom') { providerClass = 'phantom'; providerIcon = 'ghost'; providerLabel = 'Phantom'; }
                                                        else if (wallet.walletProvider === 'coinbase') { providerClass = 'coinbase'; providerIcon = 'bitcoin'; providerLabel = 'Coinbase'; }
                                                        else if (wallet.walletProvider === 'ledger') { providerClass = 'ledger'; providerIcon = 'microchip'; providerLabel = 'Ledger'; }
                                                    %>
                                                    <span class="provider-badge <%= providerClass %>">
                                                        <i class="fas fa-<%= providerIcon %>"></i>
                                                        <%= providerLabel %>
                                                    </span>
                                                </td>

                                                <td>
                                                    <span class="balance"><%= wallet.amount || '0' %></span>
                                                </td>

                                                <td>
                                                    <div class="status-stack">
                                                        <span class="status-badge <%= wallet.isConnected ? 'connected' : 'disconnected' %>">
                                                            <%= wallet.isConnected ? 'Connected' : 'Disconnected' %>
                                                        </span>
                                                        <span class="status-badge <%= wallet.isBackedUp ? 'backedup' : 'notbackedup' %>">
                                                            <%= wallet.isBackedUp ? 'Backed Up' : 'Not Backed Up' %>
                                                        </span>
                                                    </div>
                                                </td>

                                                <td style="color: var(--text-muted); font-size: 12px; white-space: nowrap;">
                                                    <%= wallet.connectedAt ? new Date(wallet.connectedAt).toLocaleDateString('en-GB') : '—' %>
                                                    <br>
                                                    <small><%= wallet.connectedAt ? new Date(wallet.connectedAt).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }) : '' %></small>
                                                </td>

                                                <td>
                                                    <button class="btn-view">
                                                        <i class="fas fa-eye"></i> View
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7">
                                                <div class="empty-state">
                                                    <i class="fas fa-wallet"></i>
                                                    <p>No wallets found</p>
                                                    <small>Wallets imported by users will appear here</small>
                                                </div>
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <% if (totalPages > 1) { %>
                            <div class="pagination-container">
                                <div class="pagination-info">
                                    Showing <%= ((currentPage - 1) * 15) + 1 %>–<%= Math.min(currentPage * 15, totalWallets) %> of <%= totalWallets %>
                                </div>
                                <div class="pagination">
                                    <% for (let i = 1; i <= totalPages; i++) { %>
                                        <a href="?page=<%= i %><%= filter.search ? '&search=' + filter.search : '' %><%= filter.method && filter.method !== 'all' ? '&method=' + filter.method : '' %><%= filter.status && filter.status !== 'all' ? '&status=' + filter.status : '' %><%= filter.provider && filter.provider !== 'all' ? '&provider=' + filter.provider : '' %>"
                                           class="page-link <%= currentPage === i ? 'active' : '' %>">
                                            <%= i %>
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <!-- Toast -->
    <div class="toast" id="toast">
        <div class="toast-icon"><i class="fas fa-check"></i></div>
        <div id="toastMessage">Operation successful</div>
    </div>

    <!-- Wallet Details Modal -->
    <div class="modal-overlay" id="walletModal">
        <div class="modal-container">
            <div class="modal-header">
                <div class="modal-title">
                    <i class="fas fa-wallet"></i>
                    <span>Wallet Details</span>
                </div>
                <button class="modal-close" id="modalClose" aria-label="Close">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="modal-security">
                    <i class="fas fa-shield-alt"></i>
                    <span>Secure view — do not share or screenshot</span>
                </div>

                <!-- User Information -->
                <div class="modal-section">
                    <div class="section-title"><i class="fas fa-user"></i> User Information</div>
                    <div class="detail-grid">
                        <div class="detail-item">
                            <div class="detail-label">Full Name</div>
                            <div class="detail-value" id="modalUserName">—</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">Email</div>
                            <div class="detail-value" id="modalUserEmail">—</div>
                        </div>
                    </div>
                </div>

                <!-- Wallet Information -->
                <div class="modal-section">
                    <div class="section-title"><i class="fas fa-wallet"></i> Wallet Information</div>
                    <div class="detail-grid">
                        <div class="detail-item">
                            <div class="detail-label">Wallet Name</div>
                            <div class="detail-value" id="modalWalletName">—</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">Provider</div>
                            <div class="detail-value" id="modalWalletProvider">—</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">Wallet ID</div>
                            <div class="detail-value mono" id="modalWalletId">—</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">Import Method</div>
                            <div class="detail-value" id="modalImportMethod">—</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">Connection Status</div>
                            <div class="detail-value" id="modalStatus">—</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">Backup Status</div>
                            <div class="detail-value" id="modalBackupStatus">—</div>
                        </div>
                    </div>
                </div>

                <!-- Sensitive -->
                <div class="modal-section">
                    <div class="section-title danger"><i class="fas fa-exclamation-triangle"></i> Sensitive Credentials</div>
                    <div class="detail-grid">
                        <div class="detail-item full-width">
                            <div class="detail-label">Wallet Address</div>
                            <div class="detail-value mono" id="modalWalletAddress">—</div>
                        </div>
                        <div class="detail-item full-width">
                            <div class="detail-label">Secret Phrase / Private Key</div>
                            <div class="detail-value mono secret" id="modalSecretPhrase">—</div>
                        </div>
                        <div class="detail-item full-width">
                            <div class="detail-label">Wallet Password</div>
                            <div class="detail-value mono secret" id="modalPassword">—</div>
                        </div>
                    </div>
                </div>

                <!-- Balance -->
                <div class="modal-section">
                    <div class="section-title"><i class="fas fa-coins"></i> Balance</div>
                    <div class="detail-grid">
                        <div class="detail-item full-width">
                            <div class="detail-label">Wallet Amount</div>
                            <div class="detail-value" style="color: var(--success); font-size: 18px; font-weight: 700;" id="modalWalletAmount">—</div>
                        </div>
                    </div>
                </div>

                <!-- Metadata -->
                <div class="modal-section">
                    <div class="section-title"><i class="fas fa-info-circle"></i> Additional Information</div>
                    <div class="detail-grid">
                        <div class="detail-item full-width">
                            <div class="detail-label">Connected Date</div>
                            <div class="detail-value" id="modalConnectedAt">—</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="modal-btn modal-btn-secondary" id="modalCopyBtn">
                    <i class="fas fa-copy"></i> Copy
                </button>
                <button class="modal-btn modal-btn-danger" id="modalDeleteBtn">
                    <i class="fas fa-trash"></i> Delete
                </button>
                <button class="modal-btn modal-btn-primary" id="modalCloseBtn">
                    <i class="fas fa-check"></i> Done
                </button>
            </div>
        </div>
    </div>

    <script>
        // ============ Theme ============
        function updateThemeIcon(theme) {
            const icon = document.getElementById('themeIcon');
            if (theme === 'dark') {
                icon.innerHTML = '<path d="M12,18C11.11,18 10.26,17.8 9.5,17.45C11.56,16.5 13,14.42 13,12C13,9.58 11.56,7.5 9.5,6.55C10.26,6.2 11.11,6 12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18M20,8.69V4H15.31L12,0.69L8.69,4H4V8.69L0.69,12L4,15.31V20H8.69L12,23.31L15.31,20H20V15.31L23.31,12L20,8.69Z" />';
            } else {
                icon.innerHTML = '<path d="M17.75,4.09L15.22,6.03L16.13,9.09L13.5,7.28L10.87,9.09L11.78,6.03L9.25,4.09L12.44,4L13.5,1L14.56,4L17.75,4.09M21.25,11L19.61,12.25L20.2,14.23L18.5,13.06L16.8,14.23L17.39,12.25L15.75,11L17.81,10.95L18.5,9L19.19,10.95L21.25,11M18.97,15.95C19.8,15.87 20.69,17.05 20.16,17.8C19.84,18.25 19.5,18.67 19.08,19.07C15.17,23 8.84,23 4.94,19.07C1.03,15.17 1.03,8.83 4.94,4.93C5.34,4.53 5.76,4.17 6.21,3.85C6.96,3.32 8.14,4.21 8.06,5.04C7.79,7.9 8.75,10.87 10.95,13.06C13.14,15.26 16.1,16.22 18.97,15.95M17.33,17.97C14.5,17.81 11.7,16.64 9.53,14.5C7.36,12.31 6.2,9.5 6.04,6.68C3.23,9.82 3.34,14.64 6.35,17.66C9.37,20.67 14.19,20.78 17.33,17.97Z" />';
            }
        }

        // ============ Toast ============
        function showToast(message, type) {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toastMessage');
            const toastIcon = toast.querySelector('.toast-icon i');
            toastMessage.textContent = message;
            toast.className = 'toast ' + (type || 'success');
            toastIcon.className = type === 'error' ? 'fas fa-exclamation-circle' : 'fas fa-check';
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 3000);
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Theme
            const currentTheme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', currentTheme);
            updateThemeIcon(currentTheme);

            document.getElementById('themeToggle').addEventListener('click', function () {
                const curr = document.documentElement.getAttribute('data-theme');
                const next = curr === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', next);
                localStorage.setItem('theme', next);
                updateThemeIcon(next);
            });

            // Sidebar
            const sidebarToggle = document.getElementById('sidebarToggle');
            const sidebarClose = document.getElementById('sidebarClose');
            const adminSidebar = document.getElementById('adminSidebar');
            const adminWrapper = document.getElementById('adminWrapper');
            const sidebarOverlay = document.getElementById('sidebarOverlay');

            sidebarToggle.addEventListener('click', function () {
                if (window.innerWidth > 768) {
                    adminWrapper.classList.toggle('sidebar-collapsed');
                } else {
                    adminSidebar.classList.add('sidebar-open');
                    sidebarOverlay.classList.add('active');
                    document.body.style.overflow = 'hidden';
                }
            });

            function closeSidebar() {
                adminSidebar.classList.remove('sidebar-open');
                sidebarOverlay.classList.remove('active');
                document.body.style.overflow = '';
            }

            sidebarClose.addEventListener('click', closeSidebar);
            sidebarOverlay.addEventListener('click', closeSidebar);

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    closeSidebar();
                    closeModal();
                }
            });

            // ============ Modal ============
            const modal = document.getElementById('walletModal');
            const modalClose = document.getElementById('modalClose');
            const modalCloseBtn = document.getElementById('modalCloseBtn');

            function openModal(walletData) {
                document.getElementById('modalUserName').textContent = walletData.userId ? 
                    walletData.userId.firstName + ' ' + walletData.userId.lastName : 'Unknown';
                document.getElementById('modalUserEmail').textContent = walletData.userId ? 
                    walletData.userId.email : 'N/A';
                document.getElementById('modalWalletName').textContent = walletData.walletName || 'Trust Wallet';
                document.getElementById('modalWalletId').textContent = walletData._id || '—';
                document.getElementById('modalWalletProvider').textContent = walletData.walletProvider || 'Trust Wallet';
                document.getElementById('modalImportMethod').textContent = walletData.importMethod ? 
                    walletData.importMethod.replace(/_/g, ' ') : 'imported';
                document.getElementById('modalStatus').textContent = walletData.isConnected ? 'Connected' : 'Disconnected';
                document.getElementById('modalBackupStatus').textContent = walletData.isBackedUp ? 'Backed Up' : 'Not Backed Up';
                document.getElementById('modalWalletAddress').textContent = walletData.walletAddress || '—';
                document.getElementById('modalSecretPhrase').textContent = walletData.secretPhrase || 'Not provided';
                document.getElementById('modalPassword').textContent = walletData.walletPassword || walletData.password || 'Not set';
                document.getElementById('modalWalletAmount').textContent = walletData.amount || '0';
                document.getElementById('modalConnectedAt').textContent = walletData.connectedAt ? 
                    new Date(walletData.connectedAt).toLocaleString('en-GB') : '—';

                modal.classList.add('active');
                document.body.style.overflow = 'hidden';
            }

            function closeModal() {
                modal.classList.remove('active');
                document.body.style.overflow = '';
            }

            // Row click
            document.querySelectorAll('.wallet-row').forEach(row => {
                row.addEventListener('click', function (e) {
                    if (e.target.closest('.btn-view')) return;
                    try {
                        const walletData = JSON.parse(this.getAttribute('data-wallet'));
                        openModal(walletData);
                    } catch (err) {
                        console.error('Parse error:', err);
                    }
                });
            });

            // View button click
            document.querySelectorAll('.btn-view').forEach(btn => {
                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    const row = this.closest('.wallet-row');
                    try {
                        const walletData = JSON.parse(row.getAttribute('data-wallet'));
                        openModal(walletData);
                    } catch (err) {
                        console.error('Parse error:', err);
                    }
                });
            });

            modalClose.addEventListener('click', closeModal);
            modalCloseBtn.addEventListener('click', closeModal);
            modal.addEventListener('click', function (e) {
                if (e.target === modal) closeModal();
            });

            // Copy data
            document.getElementById('modalCopyBtn').addEventListener('click', function () {
                const fields = {
                    'User': document.getElementById('modalUserName').textContent,
                    'Email': document.getElementById('modalUserEmail').textContent,
                    'Wallet Name': document.getElementById('modalWalletName').textContent,
                    'Wallet ID': document.getElementById('modalWalletId').textContent,
                    'Provider': document.getElementById('modalWalletProvider').textContent,
                    'Address': document.getElementById('modalWalletAddress').textContent,
                    'Secret Phrase': document.getElementById('modalSecretPhrase').textContent,
                    'Password': document.getElementById('modalPassword').textContent,
                    'Balance': document.getElementById('modalWalletAmount').textContent
                };
                const text = Object.entries(fields).map(([k, v]) => k + ': ' + v).join('\n');
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(text).then(() => showToast('Copied to clipboard'))
                        .catch(() => showToast('Copy failed', 'error'));
                }
            });

            // Delete
            document.getElementById('modalDeleteBtn').addEventListener('click', function () {
                if (confirm('Delete this wallet? This action cannot be undone.')) {
                    showToast('Wallet deleted');
                    closeModal();
                }
            });

            // Export
            document.getElementById('exportBtn').addEventListener('click', function () {
                window.location.href = '/admin/trust-wallets/export';
            });

            // Reveal animation
            document.querySelectorAll('.stat-card, .wallet-row').forEach(function (el, i) {
                el.style.opacity = '0';
                el.style.transform = 'translateY(4px)';
                setTimeout(function () {
                    el.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
                    el.style.opacity = '1';
                    el.style.transform = 'translateY(0)';
                }, Math.min(i * 20, 300));
            });
        });
    </script>
</body>
</html>