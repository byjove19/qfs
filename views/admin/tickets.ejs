<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/png" href="/images/logo.png">

    <style>
        :root {
            --bg-900: #0a0a0a;
            --bg-800: #101010;
            --bg-700: #161616;
            --bg-600: #1c1c1c;
            --border: #232323;
            --border-strong: #2e2e2e;

            --text-primary: #ededed;
            --text-secondary: #9a9a9a;
            --text-muted: #6a6a6a;

            --accent: #4b59f5;
            --accent-hover: #5d6aff;
            --accent-soft: rgba(75, 89, 245, 0.12);

            --success: #22c55e;
            --success-soft: rgba(34, 197, 94, 0.12);
            --warning: #f59e0b;
            --warning-soft: rgba(245, 158, 11, 0.12);
            --danger: #ef4444;
            --danger-soft: rgba(239, 68, 68, 0.12);
            --info: #3b82f6;
            --info-soft: rgba(59, 130, 246, 0.12);

            --radius: 10px;
            --radius-lg: 14px;
            --transition: 0.18s ease;
        }

        [data-theme="light"] {
            --bg-900: #f5f6fa;
            --bg-800: #ffffff;
            --bg-700: #f8f9fc;
            --bg-600: #eef0f6;
            --border: #e2e5ed;
            --border-strong: #d0d4df;

            --text-primary: #111827;
            --text-secondary: #4b5563;
            --text-muted: #9ca3af;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

        html { font-size: 16px; -webkit-text-size-adjust: 100%; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            font-size: 14px;
            color: var(--text-secondary);
            background: var(--bg-900);
            line-height: 1.5;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            transition: background 0.3s;
        }

        /* ========= Theme Toggle ========= */
        .theme-toggle {
            position: fixed;
            top: 18px;
            right: 18px;
            width: 40px;
            height: 40px;
            background: var(--bg-800);
            border: 1px solid var(--border);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 1001;
            transition: var(--transition);
        }
        .theme-toggle:hover { border-color: var(--accent); }
        .theme-toggle svg { width: 18px; height: 18px; fill: var(--text-secondary); }
        .theme-toggle:hover svg { fill: var(--text-primary); }

        /* ========= Layout ========= */
        .admin-wrapper { display: flex; min-height: 100vh; }

        /* ========= Sidebar ========= */
        .admin-sidebar {
            width: 260px;
            background: var(--bg-800);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            position: fixed;
            left: 0; top: 0;
            height: 100vh;
            z-index: 100;
            transition: var(--transition);
        }

        .sidebar-header {
            padding: 0 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 64px;
        }

        .logo-text {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-primary);
            text-decoration: none;
            letter-spacing: 1px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .sidebar-close {
            display: none;
            background: none;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            width: 34px;
            height: 34px;
            border-radius: 8px;
            align-items: center;
            justify-content: center;
        }
        .sidebar-close:hover { background: var(--bg-700); color: var(--text-primary); }

        .sidebar-nav { flex: 1; padding: 12px 10px; overflow-y: auto; }
        .sidebar-nav::-webkit-scrollbar { width: 4px; }
        .sidebar-nav::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }
        .sidebar-nav ul { list-style: none; }
        .sidebar-nav li { margin-bottom: 2px; }

        .nav-link {
            display: flex;
            align-items: center;
            padding: 10px 12px;
            color: var(--text-secondary);
            text-decoration: none;
            border-radius: 8px;
            transition: var(--transition);
            font-size: 13.5px;
            font-weight: 500;
            min-height: 40px;
        }
        .nav-link:hover { background: var(--bg-700); color: var(--text-primary); }
        .nav-link.active { background: var(--accent-soft); color: var(--accent); }
        .nav-link i {
            width: 20px;
            margin-right: 10px;
            font-size: 14px;
            text-align: center;
            flex-shrink: 0;
        }
        .nav-link span {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .sidebar-footer { padding: 12px 10px; border-top: 1px solid var(--border); }
        .sidebar-footer .nav-link { min-height: 38px; font-size: 13px; }

        /* ========= Main ========= */
        .admin-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            margin-left: 260px;
            width: calc(100% - 260px);
            transition: var(--transition);
        }

        /* ========= Header ========= */
        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 24px;
            background: var(--bg-800);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 99;
            min-height: 64px;
            gap: 15px;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 12px;
            flex: 1;
            min-width: 0;
        }

        .sidebar-toggle {
            background: none;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            width: 38px;
            height: 38px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: var(--transition);
        }
        .sidebar-toggle:hover { background: var(--bg-700); color: var(--text-primary); }

        .admin-header h1 {
            font-size: 17px;
            font-weight: 600;
            color: var(--text-primary);
            margin: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }

        .admin-name {
            color: var(--text-secondary);
            font-size: 13px;
            white-space: nowrap;
        }

        .badge {
            background: var(--accent-soft);
            color: var(--accent);
            padding: 5px 11px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        /* ========= Content ========= */
        .admin-content { flex: 1; padding: 24px; overflow-y: auto; }

        /* ========= Stats ========= */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 14px;
            margin-bottom: 20px;
        }

        .stat-card {
            background: var(--bg-800);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 18px;
            display: flex;
            align-items: center;
            transition: var(--transition);
        }
        .stat-card:hover { border-color: var(--border-strong); }

        .stat-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            flex-shrink: 0;
            color: #fff;
        }
        .stat-icon i { font-size: 16px; }

        .stat-icon.blue    { background: linear-gradient(135deg, #4b59f5, #6b7aff); }
        .stat-icon.orange  { background: linear-gradient(135deg, #ea580c, #f59e0b); }
        .stat-icon.green   { background: linear-gradient(135deg, #16a34a, #22c55e); }
        .stat-icon.gray    { background: linear-gradient(135deg, #475569, #64748b); }

        .stat-info h3 {
            font-size: 20px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 2px;
            line-height: 1.2;
        }
        .stat-info p {
            font-size: 11px;
            color: var(--text-muted);
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* ========= Card ========= */
        .card {
            background: var(--bg-800);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            margin-bottom: 20px;
            overflow: hidden;
        }

        .card-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .card-header h2 {
            font-size: 15px;
            font-weight: 600;
            color: var(--text-primary);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .card-header h2 i { color: var(--text-muted); font-size: 14px; }

        .filter-select {
            padding: 8px 12px;
            background: var(--bg-900);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text-primary);
            font-size: 12.5px;
            cursor: pointer;
            transition: var(--transition);
            font-family: inherit;
        }
        .filter-select:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-soft);
        }

        .card-body { padding: 0; }

        /* ========= Table ========= */
        .table-responsive {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .admin-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 900px;
        }

        .admin-table th {
            text-align: left;
            padding: 12px 16px;
            font-weight: 600;
            color: var(--text-muted);
            border-bottom: 1px solid var(--border);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            white-space: nowrap;
            background: var(--bg-700);
        }

        .admin-table td {
            padding: 14px 16px;
            border-bottom: 1px solid var(--border);
            font-size: 13px;
            vertical-align: middle;
        }

        .admin-table tr:last-child td { border-bottom: none; }
        .admin-table tr:hover { background: var(--bg-700); }

        .ticket-num {
            font-weight: 700;
            color: var(--accent);
            font-size: 12.5px;
            font-family: 'SF Mono', Monaco, 'Courier New', monospace;
        }

        .user-info { display: flex; align-items: center; gap: 10px; }

        .user-avatar {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: linear-gradient(135deg, #4b59f5, #6b7aff);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 600;
            font-size: 12px;
            flex-shrink: 0;
        }

        .user-details strong {
            color: var(--text-primary);
            display: block;
            font-weight: 600;
            font-size: 13px;
        }
        .user-details span {
            font-size: 11.5px;
            color: var(--text-muted);
        }

        .subject-cell {
            max-width: 220px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: var(--text-primary);
            font-weight: 500;
        }

        /* ========= Priority Badge ========= */
        .priority-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 9px;
            border-radius: 6px;
            font-size: 10.5px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }
        .priority-badge.low      { background: var(--success-soft); color: var(--success); }
        .priority-badge.medium   { background: var(--warning-soft); color: var(--warning); }
        .priority-badge.high     { background: var(--danger-soft); color: var(--danger); }
        .priority-badge.urgent   { background: var(--danger); color: #fff; }

        /* ========= Status Badge ========= */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.3px;
            text-transform: capitalize;
            white-space: nowrap;
        }
        .status-badge::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }
        .status-badge.open {
            background: var(--warning-soft);
            color: var(--warning);
        }
        .status-badge.open::before { background: var(--warning); }

        .status-badge.in-progress,
        .status-badge.inprogress {
            background: var(--info-soft);
            color: var(--info);
        }
        .status-badge.in-progress::before,
        .status-badge.inprogress::before { background: var(--info); }

        .status-badge.resolved {
            background: var(--success-soft);
            color: var(--success);
        }
        .status-badge.resolved::before { background: var(--success); }

        .status-badge.closed {
            background: rgba(128, 128, 128, 0.12);
            color: var(--text-muted);
        }
        .status-badge.closed::before { background: var(--text-muted); }

        /* ========= Actions ========= */
        .action-buttons { display: flex; gap: 6px; }

        .btn-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: var(--bg-700);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-secondary);
            border: 1px solid var(--border);
            transition: var(--transition);
            cursor: pointer;
            flex-shrink: 0;
            font-size: 12px;
            padding: 0;
        }
        .btn-icon:hover {
            background: var(--accent);
            color: #fff;
            border-color: var(--accent);
        }
        .btn-icon.resolve:hover {
            background: var(--success);
            border-color: var(--success);
        }
        .btn-icon:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* ========= Empty State ========= */
        .empty-state {
            text-align: center;
            padding: 50px 20px;
        }
        .empty-state i {
            font-size: 40px;
            margin-bottom: 12px;
            color: var(--text-muted);
            opacity: 0.5;
        }
        .empty-state p {
            font-size: 14px;
            margin-bottom: 4px;
            color: var(--text-primary);
            font-weight: 500;
        }
        .empty-state small {
            font-size: 12px;
            color: var(--text-muted);
        }

        /* ========= Pagination ========= */
        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            padding: 20px;
            border-top: 1px solid var(--border);
            flex-wrap: wrap;
        }

        .pagination-btn {
            padding: 8px 14px;
            background: var(--bg-700);
            color: var(--text-secondary);
            text-decoration: none;
            border-radius: 8px;
            transition: var(--transition);
            border: 1px solid var(--border);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-weight: 500;
            font-size: 12.5px;
            min-width: 34px;
            justify-content: center;
        }
        .pagination-btn:hover {
            background: var(--accent);
            color: #fff;
            border-color: var(--accent);
        }
        .pagination-btn.active {
            background: var(--accent);
            color: #fff;
            border-color: var(--accent);
        }

        /* ========= Modal ========= */
        .modal {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .modal.active { display: flex; }

        .modal-content {
            background: var(--bg-800);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
            width: 100%;
            max-width: 720px;
            max-height: 90vh;
            overflow-y: auto;
            animation: modalSlideIn 0.2s ease-out;
        }
        .modal-content::-webkit-scrollbar { width: 4px; }
        .modal-content::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

        @keyframes modalSlideIn {
            from { opacity: 0; transform: translateY(-16px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .modal-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            background: var(--bg-800);
            z-index: 1;
        }

        .modal-header h3 {
            font-size: 15px;
            font-weight: 600;
            color: var(--text-primary);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .modal-header h3 i { color: var(--accent); font-size: 14px; }

        .close-modal {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
            font-size: 14px;
            line-height: 1;
        }
        .close-modal:hover {
            background: var(--danger-soft);
            color: var(--danger);
            border-color: rgba(239, 68, 68, 0.3);
        }

        .modal-body { padding: 20px; }

        .ticket-details-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            margin-bottom: 20px;
        }

        .ticket-detail-item {
            background: var(--bg-700);
            padding: 12px 14px;
            border-radius: var(--radius);
            border: 1px solid var(--border);
        }

        .ticket-detail-label {
            font-size: 10.5px;
            color: var(--text-muted);
            text-transform: uppercase;
            font-weight: 600;
            letter-spacing: 0.5px;
            margin-bottom: 5px;
        }

        .ticket-detail-value {
            color: var(--text-primary);
            font-weight: 500;
            font-size: 13px;
            word-break: break-word;
        }

        .message-section { margin-bottom: 18px; }

        .message-section h4 {
            color: var(--text-primary);
            margin-bottom: 10px;
            font-size: 13px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .message-section h4 i { color: var(--text-muted); font-size: 12px; }

        .message-content {
            background: var(--bg-700);
            padding: 14px;
            border-radius: var(--radius);
            border: 1px solid var(--border);
            white-space: pre-wrap;
            line-height: 1.6;
            color: var(--text-primary);
            font-size: 13px;
            max-height: 220px;
            overflow-y: auto;
        }
        .message-content::-webkit-scrollbar { width: 4px; }
        .message-content::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

        .conversation-history { margin-top: 20px; }

        .conversation-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
            max-height: 300px;
            overflow-y: auto;
            padding-right: 4px;
        }
        .conversation-list::-webkit-scrollbar { width: 4px; }
        .conversation-list::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

        .conversation-item {
            background: var(--bg-700);
            padding: 12px 14px;
            border-radius: var(--radius);
            border: 1px solid var(--border);
            border-left: 3px solid var(--border-strong);
        }
        .conversation-item.admin {
            border-left-color: var(--accent);
        }

        .conversation-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 6px;
            font-size: 11.5px;
            color: var(--text-muted);
            gap: 8px;
        }

        .conversation-sender {
            font-weight: 600;
            color: var(--text-primary);
        }

        .conversation-message {
            color: var(--text-secondary);
            line-height: 1.5;
            font-size: 12.5px;
            white-space: pre-wrap;
        }

        .form-group { margin-bottom: 16px; }

        .form-group label {
            display: block;
            color: var(--text-primary);
            margin-bottom: 6px;
            font-weight: 500;
            font-size: 12.5px;
        }

        .form-control {
            width: 100%;
            padding: 10px 14px;
            background: var(--bg-900);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            color: var(--text-primary);
            font-size: 13.5px;
            transition: var(--transition);
            font-family: inherit;
        }
        .form-control:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-soft);
        }

        textarea.form-control {
            min-height: 100px;
            resize: vertical;
            line-height: 1.5;
        }

        .form-actions {
            display: flex;
            gap: 8px;
            justify-content: flex-end;
            margin-top: 20px;
            padding-top: 16px;
            border-top: 1px solid var(--border);
            flex-wrap: wrap;
        }

        .btn {
            padding: 9px 16px;
            border: none;
            border-radius: var(--radius);
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }

        .btn-primary { background: var(--accent); color: #fff; }
        .btn-primary:hover { background: var(--accent-hover); }

        .btn-secondary {
            background: var(--bg-700);
            color: var(--text-secondary);
            border: 1px solid var(--border);
        }
        .btn-secondary:hover { background: var(--bg-600); color: var(--text-primary); }

        .btn-success {
            background: var(--success);
            color: #fff;
        }
        .btn-success:hover { filter: brightness(1.1); }

        .btn:disabled { opacity: 0.6; cursor: not-allowed; }

        /* ========= Alerts ========= */
        .alert {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 16px;
            border-radius: var(--radius);
            margin-bottom: 16px;
            font-size: 13px;
        }
        .alert-success {
            background: var(--success-soft);
            border: 1px solid rgba(34, 197, 94, 0.3);
            color: var(--success);
        }
        .alert-error {
            background: var(--danger-soft);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: var(--danger);
        }

        /* ========= Responsive ========= */
        @media (max-width: 992px) {
            .admin-header { padding: 12px 18px; }
            .admin-content { padding: 18px; }
        }

        @media (max-width: 768px) {
            .theme-toggle { top: 14px; right: 14px; width: 38px; height: 38px; }

            .admin-sidebar {
                width: 260px;
                transform: translateX(-100%);
                transition: transform 0.25s ease;
                z-index: 1000;
            }
            .admin-sidebar.sidebar-open { transform: translateX(0); }
            .sidebar-close { display: flex; }

            .admin-main { margin-left: 0; width: 100%; }

            .admin-header { padding: 12px 16px; min-height: 58px; }
            .admin-header h1 { font-size: 15px; }
            .admin-name { display: none; }

            .admin-content { padding: 16px; }

            .stats-grid { grid-template-columns: 1fr 1fr; }

            .card-header { padding: 14px 16px; }
            .card-header h2 { font-size: 14px; }

            .ticket-details-grid { grid-template-columns: 1fr; }

            .form-actions { flex-direction: column-reverse; }
            .form-actions .btn { width: 100%; justify-content: center; }
        }

        @media (max-width: 480px) {
            .admin-content { padding: 12px; }
            .stats-grid { grid-template-columns: 1fr; }
            .pagination { flex-wrap: wrap; gap: 6px; }
        }

        /* Sidebar Overlay */
        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.6);
            z-index: 999;
            opacity: 0;
            transition: opacity 0.25s ease;
        }
        .sidebar-overlay.active { display: block; opacity: 1; }

        /* Desktop collapsed */
        @media (min-width: 769px) {
            .admin-wrapper.sidebar-collapsed .admin-sidebar { width: 68px; }
            .admin-wrapper.sidebar-collapsed .logo-text,
            .admin-wrapper.sidebar-collapsed .nav-link span { display: none; }
            .admin-wrapper.sidebar-collapsed .nav-link {
                justify-content: center;
                padding: 10px;
            }
            .admin-wrapper.sidebar-collapsed .nav-link i { margin-right: 0; }
            .admin-wrapper.sidebar-collapsed .admin-main {
                margin-left: 68px;
                width: calc(100% - 68px);
            }
            .admin-wrapper.sidebar-collapsed .sidebar-header {
                justify-content: center;
                padding: 0 10px;
            }
        }
    </style>
</head>
<body>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="theme-toggle" id="themeToggle">
        <svg id="themeIcon" viewBox="0 0 24 24">
            <path d="M12,18C11.11,18 10.26,17.8 9.5,17.45C11.56,16.5 13,14.42 13,12C13,9.58 11.56,7.5 9.5,6.55C10.26,6.2 11.11,6 12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18M20,8.69V4H15.31L12,0.69L8.69,4H4V8.69L0.69,12L4,15.31V20H8.69L12,23.31L15.31,20H20V15.31L23.31,12L20,8.69Z" />
        </svg>
    </div>

    <div class="admin-wrapper" id="adminWrapper">
        <!-- Sidebar -->
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="sidebar-header">
                <a href="/admin" class="logo-text">QFS Admin</a>
                <button class="sidebar-close" id="sidebarClose" aria-label="Close sidebar">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <nav class="sidebar-nav">
                <ul>
                    <li><a href="/admin" class="nav-link"><i class="fas fa-th-large"></i> <span>Dashboard</span></a></li>
                    <li><a href="/admin/users" class="nav-link"><i class="fas fa-users"></i> <span>Users</span></a></li>
                    <li><a href="/admin/transactions" class="nav-link"><i class="fas fa-exchange-alt"></i> <span>Transactions</span></a></li>
                    <li><a href="/admin/trust-wallets" class="nav-link"><i class="fas fa-shield-alt"></i> <span>Trust Wallets</span></a></li>
                    <li><a href="/admin/investments" class="nav-link"><i class="fas fa-chart-line"></i> <span>Investments</span></a></li>
                    <li><a href="/admin/tickets" class="nav-link active"><i class="fas fa-headset"></i> <span>Support Tickets</span></a></li>
                    <li><a href="/admin/pending-deposits" class="nav-link"><i class="fas fa-arrow-down"></i> <span>Pending Deposits</span></a></li>
                    <li><a href="/admin/wallet-addresses" class="nav-link"><i class="fas fa-address-book"></i> <span>Wallet Addresses</span></a></li>
                    <li><a href="/admin/pending-withdrawals" class="nav-link"><i class="fas fa-arrow-up"></i> <span>Pending Withdrawals</span></a></li>
                    <li><a href="/admin/pending-transfers" class="nav-link"><i class="fas fa-paper-plane"></i> <span>Pending Transfers</span></a></li>
                    <li><a href="/admin/send-email" class="nav-link"><i class="fas fa-envelope"></i> <span>Send Email</span></a></li>
                    <li><a href="/admin/exchange" class="nav-link"><i class="fas fa-dollar-sign"></i> <span>Exchange Rate</span></a></li>
                </ul>
            </nav>
            <div class="sidebar-footer">
                <a href="/dashboard" class="nav-link"><i class="fas fa-arrow-left"></i> <span>Back to Site</span></a>
                <a href="/auth/logout" class="nav-link"><i class="fas fa-sign-out-alt"></i> <span>Logout</span></a>
            </div>
        </aside>

        <!-- Main -->
        <main class="admin-main">
            <header class="admin-header">
                <div class="header-left">
                    <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h1><%= title %></h1>
                </div>
                <div class="header-right">
                    <span class="admin-name">Welcome, <%= user.firstName %> <%= user.lastName %></span>
                    <span class="badge"><%= user.role %></span>
                </div>
            </header>

            <div class="admin-content">

                <% if (messages && messages.error) { %>
                    <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= messages.error %></div>
                <% } %>
                <% if (messages && messages.success) { %>
                    <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= messages.success %></div>
                <% } %>

                <!-- Stats -->
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon blue"><i class="fas fa-headset"></i></div>
                        <div class="stat-info">
                            <h3><%= totalTickets || 0 %></h3>
                            <p>Total Tickets</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon orange"><i class="fas fa-clock"></i></div>
                        <div class="stat-info">
                            <h3><%= tickets ? tickets.filter(t => t.status === 'open').length : 0 %></h3>
                            <p>Open</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon green"><i class="fas fa-check"></i></div>
                        <div class="stat-info">
                            <h3><%= tickets ? tickets.filter(t => t.status === 'resolved' || t.status === 'closed').length : 0 %></h3>
                            <p>Resolved</p>
                        </div>
                    </div>
                </div>

                <!-- Tickets -->
                <div class="card">
                    <div class="card-header">
                        <h2><i class="fas fa-headset"></i> Support Tickets</h2>
                        <select id="statusFilter" class="filter-select">
                            <option value="all" <%= filter.status === 'all' ? 'selected' : '' %>>All Status</option>
                            <option value="open" <%= filter.status === 'open' ? 'selected' : '' %>>Open</option>
                            <option value="in-progress" <%= filter.status === 'in-progress' ? 'selected' : '' %>>In Progress</option>
                            <option value="resolved" <%= filter.status === 'resolved' ? 'selected' : '' %>>Resolved</option>
                            <option value="closed" <%= filter.status === 'closed' ? 'selected' : '' %>>Closed</option>
                        </select>
                    </div>
                    <div class="card-body">
                        <% if (tickets && tickets.length > 0) { %>
                            <div class="table-responsive">
                                <table class="admin-table">
                                    <thead>
                                        <tr>
                                            <th>Ticket</th>
                                            <th>User</th>
                                            <th>Subject</th>
                                            <th>Priority</th>
                                            <th>Status</th>
                                            <th>Created</th>
                                            <th>Updated</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% tickets.forEach(ticket => { %>
                                            <tr data-ticket-id="<%= ticket._id %>">
                                                <td>
                                                    <span class="ticket-num">#<%= ticket.ticketNumber || ticket._id.toString().slice(-6) %></span>
                                                </td>
                                                <td>
                                                    <% if (ticket.userId && ticket.userId._id) { %>
                                                        <div class="user-info">
                                                            <div class="user-avatar">
                                                                <%= ticket.userId.firstName.charAt(0).toUpperCase() %><%= ticket.userId.lastName.charAt(0).toUpperCase() %>
                                                            </div>
                                                            <div class="user-details">
                                                                <strong><%= ticket.userId.firstName %> <%= ticket.userId.lastName %></strong>
                                                                <span><%= ticket.userId.email %></span>
                                                            </div>
                                                        </div>
                                                    <% } else { %>
                                                        <span style="color: var(--text-muted); font-style: italic;">User not found</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <div class="subject-cell"><%= ticket.subject %></div>
                                                </td>
                                                <td>
                                                    <span class="priority-badge <%= ticket.priority || 'medium' %>">
                                                        <%= ticket.priority || 'medium' %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="status-badge <%= ticket.status %>">
                                                        <%= ticket.status %>
                                                    </span>
                                                </td>
                                                <td style="color: var(--text-muted); font-size: 12px; white-space: nowrap;">
                                                    <%= new Date(ticket.createdAt).toLocaleDateString('en-GB') %>
                                                    <br>
                                                    <small><%= new Date(ticket.createdAt).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }) %></small>
                                                </td>
                                                <td style="color: var(--text-muted); font-size: 12px; white-space: nowrap;">
                                                    <%= new Date(ticket.updatedAt).toLocaleDateString('en-GB') %>
                                                    <br>
                                                    <small><%= new Date(ticket.updatedAt).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }) %></small>
                                                </td>
                                                <td>
                                                    <div class="action-buttons">
                                                        <button class="btn-icon view-ticket" data-ticket-id="<%= ticket._id %>" title="View ticket">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                        <% if (ticket.status === 'open' || ticket.status === 'in-progress') { %>
                                                            <button class="btn-icon resolve resolve-ticket" data-ticket-id="<%= ticket._id %>" title="Resolve">
                                                                <i class="fas fa-check"></i>
                                                            </button>
                                                        <% } %>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>

                            <% if (totalPages > 1) { %>
                                <div class="pagination">
                                    <% if (currentPage > 1) { %>
                                        <a href="?page=<%= currentPage - 1 %><%= filter.status && filter.status !== 'all' ? '&status=' + filter.status : '' %>" class="pagination-btn">
                                            <i class="fas fa-chevron-left"></i>
                                        </a>
                                    <% } %>
                                    <% for (let i = 1; i <= totalPages; i++) { %>
                                        <a href="?page=<%= i %><%= filter.status && filter.status !== 'all' ? '&status=' + filter.status : '' %>"
                                           class="pagination-btn <%= currentPage === i ? 'active' : '' %>">
                                            <%= i %>
                                        </a>
                                    <% } %>
                                    <% if (currentPage < totalPages) { %>
                                        <a href="?page=<%= currentPage + 1 %><%= filter.status && filter.status !== 'all' ? '&status=' + filter.status : '' %>" class="pagination-btn">
                                            <i class="fas fa-chevron-right"></i>
                                        </a>
                                    <% } %>
                                </div>
                            <% } %>

                        <% } else { %>
                            <div class="empty-state">
                                <i class="fas fa-headset"></i>
                                <p>No tickets found</p>
                                <small>
                                    <% if (filter.status && filter.status !== 'all') { %>
                                        No <%= filter.status %> tickets at the moment
                                    <% } else { %>
                                        There are no support tickets in the system
                                    <% } %>
                                </small>
                            </div>
                        <% } %>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <!-- Ticket Modal -->
    <div id="ticketModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3><i class="fas fa-ticket-alt"></i> Ticket Details</h3>
                <button class="close-modal" aria-label="Close">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="ticket-details-grid">
                    <div class="ticket-detail-item">
                        <div class="ticket-detail-label">User</div>
                        <div class="ticket-detail-value" id="modal-user">—</div>
                    </div>
                    <div class="ticket-detail-item">
                        <div class="ticket-detail-label">Email</div>
                        <div class="ticket-detail-value" id="modal-email">—</div>
                    </div>
                    <div class="ticket-detail-item">
                        <div class="ticket-detail-label">Priority</div>
                        <div class="ticket-detail-value" id="modal-priority">—</div>
                    </div>
                    <div class="ticket-detail-item">
                        <div class="ticket-detail-label">Status</div>
                        <div class="ticket-detail-value" id="modal-status">—</div>
                    </div>
                    <div class="ticket-detail-item">
                        <div class="ticket-detail-label">Created</div>
                        <div class="ticket-detail-value" id="modal-created">—</div>
                    </div>
                    <div class="ticket-detail-item">
                        <div class="ticket-detail-label">Last Updated</div>
                        <div class="ticket-detail-value" id="modal-updated">—</div>
                    </div>
                </div>

                <div class="message-section">
                    <h4><i class="fas fa-tag"></i> Subject</h4>
                    <div class="message-content" id="modal-subject">—</div>
                </div>

                <div class="message-section">
                    <h4><i class="fas fa-comment"></i> Initial Message</h4>
                    <div class="message-content" id="modal-message">—</div>
                </div>

                <div class="conversation-history" id="conversation-history" style="display: none;">
                    <h4 class="message-section" style="margin-bottom: 10px;"><i class="fas fa-comments"></i> Conversation</h4>
                    <div class="conversation-list" id="conversation-list"></div>
                </div>

                <form id="ticketResponseForm">
                    <input type="hidden" id="ticketId" name="ticketId">

                    <div class="message-section" style="margin-top: 20px;">
                        <h4><i class="fas fa-reply"></i> Update Ticket</h4>

                        <div class="form-group">
                            <label for="responseStatus">Status</label>
                            <select class="form-control" id="responseStatus" name="status">
                                <option value="open">Open</option>
                                <option value="in-progress">In Progress</option>
                                <option value="resolved">Resolved</option>
                                <option value="closed">Closed</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="adminResponse">Response Message</label>
                            <textarea class="form-control" id="adminResponse" name="response" placeholder="Type your response to the user..."></textarea>
                        </div>

                        <div class="form-actions">
                            <button type="button" class="btn btn-secondary close-modal">
                                <i class="fas fa-times"></i> Cancel
                            </button>
                            <button type="button" class="btn btn-success" id="resolveTicket">
                                <i class="fas fa-check"></i> Mark Resolved
                            </button>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-paper-plane"></i> Send Response
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        // ============ CSRF ============
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') ||
                         document.querySelector('input[name="_csrf"]')?.value;

        // ============ Theme ============
        function updateThemeIcon(theme) {
            const icon = document.getElementById('themeIcon');
            if (theme === 'dark') {
                icon.innerHTML = '<path d="M12,18C11.11,18 10.26,17.8 9.5,17.45C11.56,16.5 13,14.42 13,12C13,9.58 11.56,7.5 9.5,6.55C10.26,6.2 11.11,6 12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18M20,8.69V4H15.31L12,0.69L8.69,4H4V8.69L0.69,12L4,15.31V20H8.69L12,23.31L15.31,20H20V15.31L23.31,12L20,8.69Z" />';
            } else {
                icon.innerHTML = '<path d="M17.75,4.09L15.22,6.03L16.13,9.09L13.5,7.28L10.87,9.09L11.78,6.03L9.25,4.09L12.44,4L13.5,1L14.56,4L17.75,4.09M21.25,11L19.61,12.25L20.2,14.23L18.5,13.06L16.8,14.23L17.39,12.25L15.75,11L17.81,10.95L18.5,9L19.19,10.95L21.25,11M18.97,15.95C19.8,15.87 20.69,17.05 20.16,17.8C19.84,18.25 19.5,18.67 19.08,19.07C15.17,23 8.84,23 4.94,19.07C1.03,15.17 1.03,8.83 4.94,4.93C5.34,4.53 5.76,4.17 6.21,3.85C6.96,3.32 8.14,4.21 8.06,5.04C7.79,7.9 8.75,10.87 10.95,13.06C13.14,15.26 16.1,16.22 18.97,15.95M17.33,17.97C14.5,17.81 11.7,16.64 9.53,14.5C7.36,12.31 6.2,9.5 6.04,6.68C3.23,9.82 3.34,14.64 6.35,17.66C9.37,20.67 14.19,20.78 17.33,17.97Z" />';
            }
        }

        // ============ Modal ============
        const modal = document.getElementById('ticketModal');
        let originalModalContent = null;

        function openModal() {
            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            modal.classList.remove('active');
            document.body.style.overflow = '';
            restoreModalContent();
        }

        function restoreModalContent() {
            if (!originalModalContent) return;
            const modalBody = modal.querySelector('.modal-body');
            if (modalBody) {
                modalBody.innerHTML = originalModalContent;
                reattachModalListeners();
            }
        }

        function reattachModalListeners() {
            // Close button
            modal.querySelectorAll('.close-modal').forEach(btn => {
                btn.addEventListener('click', closeModal);
            });

            // Resolve button
            const resolveBtn = document.getElementById('resolveTicket');
            if (resolveBtn) {
                resolveBtn.addEventListener('click', function () {
                    const ticketId = document.getElementById('ticketId')?.value;
                    if (ticketId) resolveTicket(ticketId, this);
                });
            }

            // Form submission
            const form = document.getElementById('ticketResponseForm');
            if (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    submitTicketResponse();
                });
            }
        }

        // ============ Badges ============
        function priorityBadge(priority) {
            const p = (priority || 'medium').toLowerCase();
            return `<span class="priority-badge ${p}">${p}</span>`;
        }

        function statusBadge(status) {
            return `<span class="status-badge ${status}">${status}</span>`;
        }

        function safeSetText(id, text) {
            const el = document.getElementById(id);
            if (el) el.textContent = text;
        }

        function safeSetHtml(id, html) {
            const el = document.getElementById(id);
            if (el) el.innerHTML = html;
        }

        // ============ Open Ticket Modal ============
    
         // ============ Open Ticket Modal ============
function openTicketModal(ticketId) {
    if (!modal) return;

    // Store original modal content on first open
    const modalBody = modal.querySelector('.modal-body');
    if (!originalModalContent && modalBody) {
        originalModalContent = modalBody.innerHTML;
    }

    showLoading();
    openModal();

    // Fetch full ticket details
    fetch(`/admin/tickets/${ticketId}/details`, {
        headers: { 'X-CSRF-TOKEN': csrfToken, 'Content-Type': 'application/json' }
    })
    .then(r => {
        if (!r.ok) throw new Error(`HTTP ${r.status}`);
        return r.json();
    })
    .then(data => {
        if (data.success) {
            restoreModalContent();
            populateModal(data.ticket);
        } else {
            throw new Error(data.message || 'Failed to load ticket');
        }
    })
    .catch(err => {
        console.error('Error loading ticket:', err);
        restoreModalContent();
    });
}

function showLoading() {
    const modalBody = modal.querySelector('.modal-body');
    if (modalBody) {
        modalBody.innerHTML = `
            <div style="text-align: center; padding: 40px; color: var(--text-muted);">
                <i class="fas fa-spinner fa-spin" style="font-size: 22px; margin-bottom: 12px; display: block;"></i>
                Loading ticket details...
            </div>
        `;
    }
}

function populateModal(ticket) {
    if (!ticket) return;

    safeSetText('modal-user', ticket.userId ? `${ticket.userId.firstName} ${ticket.userId.lastName}` : 'User not found');
    safeSetText('modal-email', ticket.userId ? ticket.userId.email : 'N/A');
    safeSetText('modal-subject', ticket.subject || 'No subject');

    const initialMessage = ticket.messages && ticket.messages.length > 0
        ? ticket.messages[0].message
        : 'No message available';
    safeSetText('modal-message', initialMessage);

    safeSetText('modal-created', ticket.createdAt ? new Date(ticket.createdAt).toLocaleString('en-GB') : '—');
    safeSetText('modal-updated', ticket.updatedAt ? new Date(ticket.updatedAt).toLocaleString('en-GB') : '—');

    safeSetHtml('modal-priority', priorityBadge(ticket.priority || 'medium'));
    safeSetHtml('modal-status', statusBadge(ticket.status || 'open'));

    const statusDropdown = document.getElementById('responseStatus');
    if (statusDropdown) statusDropdown.value = ticket.status || 'open';

    const ticketIdInput = document.getElementById('ticketId');
    if (ticketIdInput) ticketIdInput.value = ticket._id || ticket.id;

    // Conversation history (skip first message)
    if (ticket.messages && ticket.messages.length > 1) {
        renderConversation(ticket.messages.slice(1));
    } else {
        const history = document.getElementById('conversation-history');
        if (history) history.style.display = 'none';
    }

    // Show/hide resolve button
    const resolveBtn = document.getElementById('resolveTicket');
    if (resolveBtn) {
        const show = ['open', 'in-progress', 'on-hold'].includes(ticket.status);
        resolveBtn.style.display = show ? 'inline-flex' : 'none';
    }
}

function renderConversation(messages) {
    const history = document.getElementById('conversation-history');
    const list = document.getElementById('conversation-list');
    if (!history || !list) return;

    const visible = messages
        .filter(m => !m.isInternal)
        .sort((a, b) => new Date(a.timestamp) - new Date(b.timestamp));

    if (visible.length === 0) {
        history.style.display = 'none';
        return;
    }

    list.innerHTML = visible.map(msg => {
        const isAdmin = msg.senderId?.role === 'admin';
        const senderName = msg.senderId
            ? (isAdmin ? 'Admin' : `${msg.senderId.firstName} ${msg.senderId.lastName}`)
            : 'Unknown';
        const date = new Date(msg.timestamp).toLocaleString('en-GB');

        return `
            <div class="conversation-item ${isAdmin ? 'admin' : ''}">
                <div class="conversation-header">
                    <span class="conversation-sender">${escapeHtml(senderName)}</span>
                    <span>${escapeHtml(date)}</span>
                </div>
                <div class="conversation-message">${escapeHtml(msg.message)}</div>
            </div>
        `;
    }).join('');

    history.style.display = 'block';
}
        // ============ Submit Response ============
        function submitTicketResponse() {
            const ticketId = document.getElementById('ticketId')?.value;
            const status = document.getElementById('responseStatus')?.value;
            const response = document.getElementById('adminResponse')?.value.trim();

            if (!ticketId) return alert('Ticket ID missing');
            if (!response) return alert('Please enter a response message');

            const form = document.getElementById('ticketResponseForm');
            const submitBtn = form.querySelector('button[type="submit"]');
            const originalHtml = submitBtn.innerHTML;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending...';
            submitBtn.disabled = true;

            fetch('/admin/tickets/respond', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken },
                body: JSON.stringify({ ticketId, status, response })
            })
            .then(r => {
                if (!r.ok) throw new Error(`HTTP ${r.status}`);
                return r.json();
            })
            .then(data => {
                if (data.success) {
                    closeModal();
                    window.location.reload();
                } else {
                    throw new Error(data.message || 'Failed to send response');
                }
            })
            .catch(err => {
                console.error(err);
                alert('Error: ' + err.message);
                submitBtn.innerHTML = originalHtml;
                submitBtn.disabled = false;
            });
        }

        // ============ Resolve Ticket ============
        function resolveTicket(ticketId, btn) {
            if (!ticketId) return alert('Ticket ID missing');
            if (!confirm('Mark this ticket as resolved?')) return;

            const originalHtml = btn ? btn.innerHTML : null;
            if (btn) {
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                btn.disabled = true;
            }

            fetch('/admin/tickets/resolve', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken },
                body: JSON.stringify({ ticketId })
            })
            .then(r => {
                if (!r.ok) throw new Error(`HTTP ${r.status}`);
                return r.json();
            })
            .then(data => {
                if (data.success) {
                    window.location.reload();
                } else {
                    throw new Error(data.message || 'Failed to resolve ticket');
                }
            })
            .catch(err => {
                console.error(err);
                alert('Error: ' + err.message);
                if (btn && originalHtml) {
                    btn.innerHTML = originalHtml;
                    btn.disabled = false;
                }
            });
        }

        // ============ Escape ============
        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        // ============ Init ============
        document.addEventListener('DOMContentLoaded', function () {
            // Theme
            const currentTheme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', currentTheme);
            updateThemeIcon(currentTheme);

            document.getElementById('themeToggle').addEventListener('click', function () {
                const curr = document.documentElement.getAttribute('data-theme');
                const next = curr === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', next);
                localStorage.setItem('theme', next);
                updateThemeIcon(next);
            });

            // Sidebar
            const sidebarToggle = document.getElementById('sidebarToggle');
            const sidebarClose = document.getElementById('sidebarClose');
            const adminSidebar = document.getElementById('adminSidebar');
            const adminWrapper = document.getElementById('adminWrapper');
            const sidebarOverlay = document.getElementById('sidebarOverlay');

            sidebarToggle.addEventListener('click', function () {
                if (window.innerWidth > 768) {
                    adminWrapper.classList.toggle('sidebar-collapsed');
                } else {
                    adminSidebar.classList.add('sidebar-open');
                    sidebarOverlay.classList.add('active');
                    document.body.style.overflow = 'hidden';
                }
            });

            function closeSidebar() {
                adminSidebar.classList.remove('sidebar-open');
                sidebarOverlay.classList.remove('active');
                document.body.style.overflow = '';
            }

            sidebarClose.addEventListener('click', closeSidebar);
            sidebarOverlay.addEventListener('click', closeSidebar);

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    closeSidebar();
                    if (modal.classList.contains('active')) closeModal();
                }
            });

            // Filter
            document.getElementById('statusFilter').addEventListener('change', function () {
                const url = new URL(window.location.href);
                if (this.value === 'all') {
                    url.searchParams.delete('status');
                } else {
                    url.searchParams.set('status', this.value);
                }
                url.searchParams.delete('page');
                window.location.href = url.toString();
            });

            // View ticket buttons
            document.querySelectorAll('.view-ticket').forEach(btn => {
                btn.addEventListener('click', function () {
                    openTicketModal(this.dataset.ticketId);
                });
            });

            // Resolve from table
            document.querySelectorAll('.resolve-ticket').forEach(btn => {
                btn.addEventListener('click', function () {
                    resolveTicket(this.dataset.ticketId, this);
                });
            });

            // Initial modal listeners
            reattachModalListeners();

            // Close on outside click
            modal.addEventListener('click', function (e) {
                if (e.target === modal) closeModal();
            });

            // Reveal animation
            document.querySelectorAll('.stat-card, .admin-table tbody tr').forEach(function (el, i) {
                el.style.opacity = '0';
                el.style.transform = 'translateY(4px)';
                setTimeout(function () {
                    el.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
                    el.style.opacity = '1';
                    el.style.transform = 'translateY(0)';
                }, Math.min(i * 20, 300));
            });
        });
    </script>
</body>
</html>