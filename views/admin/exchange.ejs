<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/png" href="/images/logo.png">

    <style>
        :root {
            --bg-900: #0a0a0a;
            --bg-800: #101010;
            --bg-700: #161616;
            --bg-600: #1c1c1c;
            --border: #232323;
            --border-strong: #2e2e2e;

            --text-primary: #ededed;
            --text-secondary: #9a9a9a;
            --text-muted: #6a6a6a;

            --accent: #4b59f5;
            --accent-hover: #5d6aff;
            --accent-soft: rgba(75, 89, 245, 0.12);

            --success: #22c55e;
            --success-soft: rgba(34, 197, 94, 0.12);
            --warning: #f59e0b;
            --warning-soft: rgba(245, 158, 11, 0.12);
            --danger: #ef4444;
            --danger-soft: rgba(239, 68, 68, 0.12);
            --info: #3b82f6;
            --info-soft: rgba(59, 130, 246, 0.12);
            --purple: #8b5cf6;
            --purple-soft: rgba(139, 92, 246, 0.12);

            --radius: 10px;
            --radius-lg: 14px;
            --transition: 0.18s ease;
        }

        [data-theme="light"] {
            --bg-900: #f5f6fa;
            --bg-800: #ffffff;
            --bg-700: #f8f9fc;
            --bg-600: #eef0f6;
            --border: #e2e5ed;
            --border-strong: #d0d4df;

            --text-primary: #111827;
            --text-secondary: #4b5563;
            --text-muted: #9ca3af;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

        html { font-size: 16px; -webkit-text-size-adjust: 100%; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            font-size: 14px;
            color: var(--text-secondary);
            background: var(--bg-900);
            line-height: 1.5;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            transition: background 0.3s;
        }

        /* ========= Theme Toggle ========= */
        .theme-toggle {
            position: fixed;
            top: 18px;
            right: 18px;
            width: 40px;
            height: 40px;
            background: var(--bg-800);
            border: 1px solid var(--border);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 1001;
            transition: var(--transition);
        }
        .theme-toggle:hover { border-color: var(--accent); }
        .theme-toggle svg { width: 18px; height: 18px; fill: var(--text-secondary); }
        .theme-toggle:hover svg { fill: var(--text-primary); }

        /* ========= Layout ========= */
        .admin-wrapper { display: flex; min-height: 100vh; }

        /* ========= Sidebar ========= */
        .admin-sidebar {
            width: 260px;
            background: var(--bg-800);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            position: fixed;
            left: 0; top: 0;
            height: 100vh;
            z-index: 100;
            transition: var(--transition);
        }

        .sidebar-header {
            padding: 0 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 64px;
        }

        .logo-text {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-primary);
            text-decoration: none;
            letter-spacing: 1px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .sidebar-close {
            display: none;
            background: none;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            width: 34px;
            height: 34px;
            border-radius: 8px;
            align-items: center;
            justify-content: center;
        }
        .sidebar-close:hover { background: var(--bg-700); color: var(--text-primary); }

        .sidebar-nav { flex: 1; padding: 12px 10px; overflow-y: auto; }
        .sidebar-nav::-webkit-scrollbar { width: 4px; }
        .sidebar-nav::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }
        .sidebar-nav ul { list-style: none; }
        .sidebar-nav li { margin-bottom: 2px; }

        .nav-link {
            display: flex;
            align-items: center;
            padding: 10px 12px;
            color: var(--text-secondary);
            text-decoration: none;
            border-radius: 8px;
            transition: var(--transition);
            font-size: 13.5px;
            font-weight: 500;
            min-height: 40px;
        }
        .nav-link:hover { background: var(--bg-700); color: var(--text-primary); }
        .nav-link.active { background: var(--accent-soft); color: var(--accent); }
        .nav-link i {
            width: 20px;
            margin-right: 10px;
            font-size: 14px;
            text-align: center;
            flex-shrink: 0;
        }
        .nav-link span {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .sidebar-footer { padding: 12px 10px; border-top: 1px solid var(--border); }
        .sidebar-footer .nav-link { min-height: 38px; font-size: 13px; }

        /* ========= Main ========= */
        .admin-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            margin-left: 260px;
            width: calc(100% - 260px);
            transition: var(--transition);
        }

        /* ========= Header ========= */
        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 24px;
            background: var(--bg-800);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 99;
            min-height: 64px;
            gap: 15px;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 12px;
            flex: 1;
            min-width: 0;
        }

        .sidebar-toggle {
            background: none;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            width: 38px;
            height: 38px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: var(--transition);
        }
        .sidebar-toggle:hover { background: var(--bg-700); color: var(--text-primary); }

        .admin-header h1 {
            font-size: 17px;
            font-weight: 600;
            color: var(--text-primary);
            margin: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }

        .admin-name {
            color: var(--text-secondary);
            font-size: 13px;
            white-space: nowrap;
        }

        .badge {
            background: var(--accent-soft);
            color: var(--accent);
            padding: 5px 11px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        /* ========= Content ========= */
        .admin-content { flex: 1; padding: 24px; overflow-y: auto; }

        /* ========= Stats ========= */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 14px;
            margin-bottom: 20px;
        }

        .stat-card {
            background: var(--bg-800);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 18px;
            display: flex;
            align-items: center;
            transition: var(--transition);
        }
        .stat-card:hover { border-color: var(--border-strong); }

        .stat-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            flex-shrink: 0;
            color: #fff;
        }
        .stat-icon i { font-size: 16px; }

        .stat-icon.blue    { background: linear-gradient(135deg, #4b59f5, #6b7aff); }
        .stat-icon.green   { background: linear-gradient(135deg, #16a34a, #22c55e); }
        .stat-icon.purple  { background: linear-gradient(135deg, #7c3aed, #a855f7); }

        .stat-info h3 {
            font-size: 20px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 2px;
            line-height: 1.2;
        }
        .stat-info p {
            font-size: 11px;
            color: var(--text-muted);
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* ========= Card ========= */
        .card {
            background: var(--bg-800);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            margin-bottom: 20px;
            overflow: hidden;
        }

        .card-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .card-header h2 {
            font-size: 15px;
            font-weight: 600;
            color: var(--text-primary);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .card-header h2 i { color: var(--text-muted); font-size: 14px; }

        .card-header-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .card-body { padding: 20px; }

        /* ========= Buttons ========= */
        .tg-btn {
            background: var(--accent);
            color: #fff;
            padding: 8px 14px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 12.5px;
            font-weight: 500;
            transition: var(--transition);
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
            font-family: inherit;
        }
        .tg-btn:hover { background: var(--accent-hover); }

        .tg-btn.secondary {
            background: var(--bg-700);
            color: var(--text-secondary);
            border: 1px solid var(--border);
        }
        .tg-btn.secondary:hover {
            background: var(--bg-600);
            color: var(--text-primary);
            border-color: var(--border-strong);
        }

        .tg-btn.success {
            background: var(--success);
        }
        .tg-btn.success:hover { filter: brightness(1.1); }

        .tg-btn.purple {
            background: var(--purple);
        }
        .tg-btn.purple:hover { filter: brightness(1.1); }

        /* ========= Currency Grid ========= */
        .currency-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 14px;
        }

        .currency-group { margin-bottom: 24px; }
        .currency-group:last-child { margin-bottom: 0; }

        .currency-group-title {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 12px;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .currency-group-title i { color: var(--accent); font-size: 11px; }

        .currency-card {
            background: var(--bg-700);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 16px;
            transition: var(--transition);
        }
        .currency-card:hover { border-color: var(--border-strong); }

        .currency-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
            gap: 8px;
        }

        .currency-pair {
            font-size: 13.5px;
            font-weight: 700;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 6px;
            font-family: 'SF Mono', Monaco, 'Courier New', monospace;
        }
        .currency-pair i {
            color: var(--text-muted);
            font-size: 10px;
            font-weight: 400;
        }

        .currency-rate {
            font-size: 20px;
            font-weight: 700;
            color: var(--accent);
            margin-bottom: 12px;
            font-family: 'SF Mono', Monaco, 'Courier New', monospace;
            word-break: break-all;
        }

        .currency-details {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin-bottom: 12px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border);
        }

        .currency-detail {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }
        .currency-detail span {
            font-size: 10.5px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.4px;
            font-weight: 600;
        }
        .currency-detail strong {
            font-size: 12.5px;
            color: var(--text-primary);
            font-weight: 600;
        }

        .currency-actions {
            display: flex;
            gap: 6px;
        }

        .btn-icon {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            background: var(--bg-600);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-secondary);
            border: 1px solid var(--border);
            transition: var(--transition);
            cursor: pointer;
            flex-shrink: 0;
            font-size: 11px;
            padding: 0;
        }
        .btn-icon:hover {
            background: var(--accent);
            color: #fff;
            border-color: var(--accent);
        }
        .btn-icon.edit {
            color: var(--warning);
            border-color: rgba(245, 158, 11, 0.3);
            background: var(--warning-soft);
        }
        .btn-icon.edit:hover {
            background: var(--warning);
            color: #fff;
            border-color: var(--warning);
        }
        .btn-icon.toggle-on {
            color: var(--success);
            border-color: rgba(34, 197, 94, 0.3);
            background: var(--success-soft);
        }
        .btn-icon.toggle-on:hover {
            background: var(--success);
            color: #fff;
            border-color: var(--success);
        }
        .btn-icon.toggle-off {
            color: var(--danger);
            border-color: rgba(239, 68, 68, 0.3);
            background: var(--danger-soft);
        }
        .btn-icon.toggle-off:hover {
            background: var(--danger);
            color: #fff;
            border-color: var(--danger);
        }
        .btn-icon.delete {
            color: var(--danger);
            border-color: rgba(239, 68, 68, 0.3);
            background: var(--danger-soft);
        }
        .btn-icon.delete:hover {
            background: var(--danger);
            color: #fff;
            border-color: var(--danger);
        }

        /* ========= Status Badge ========= */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 3px 9px;
            border-radius: 20px;
            font-size: 10.5px;
            font-weight: 600;
            letter-spacing: 0.3px;
            text-transform: capitalize;
            white-space: nowrap;
        }
        .status-badge::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }
        .status-badge.active {
            background: var(--success-soft);
            color: var(--success);
        }
        .status-badge.active::before { background: var(--success); }
        .status-badge.inactive {
            background: rgba(128, 128, 128, 0.12);
            color: var(--text-muted);
        }
        .status-badge.inactive::before { background: var(--text-muted); }

        /* ========= Empty State ========= */
        .empty-state {
            text-align: center;
            padding: 50px 20px;
        }
        .empty-state i {
            font-size: 40px;
            margin-bottom: 12px;
            color: var(--text-muted);
            opacity: 0.5;
        }
        .empty-state p {
            font-size: 14px;
            margin-bottom: 4px;
            color: var(--text-primary);
            font-weight: 500;
        }
        .empty-state small {
            font-size: 12px;
            color: var(--text-muted);
        }

        /* ========= Modal ========= */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            padding: 20px;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.2s ease, visibility 0.2s ease;
        }
        .modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .modal {
            background: var(--bg-800);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            width: 100%;
            max-width: 520px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
            transform: scale(0.96);
            transition: transform 0.2s ease;
        }
        .modal-overlay.active .modal { transform: scale(1); }
        .modal::-webkit-scrollbar { width: 4px; }
        .modal::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

        .modal-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            background: var(--bg-800);
            z-index: 1;
        }

        .modal-header h3 {
            font-size: 15px;
            font-weight: 600;
            color: var(--text-primary);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .modal-header h3 i { color: var(--accent); font-size: 14px; }

        .modal-close {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
            font-size: 14px;
            line-height: 1;
        }
        .modal-close:hover {
            background: var(--danger-soft);
            color: var(--danger);
            border-color: rgba(239, 68, 68, 0.3);
        }

        .modal-body { padding: 20px; }

        .modal-footer {
            padding: 14px 20px;
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            flex-wrap: wrap;
            position: sticky;
            bottom: 0;
            background: var(--bg-800);
        }

        /* ========= Forms ========= */
        .form-group { margin-bottom: 16px; }

        .form-label {
            display: block;
            margin-bottom: 6px;
            font-weight: 500;
            color: var(--text-primary);
            font-size: 12.5px;
        }

        .form-control {
            width: 100%;
            padding: 10px 14px;
            background: var(--bg-900);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            color: var(--text-primary);
            font-size: 13.5px;
            transition: var(--transition);
            font-family: inherit;
        }
        .form-control:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-soft);
        }
        .form-control::placeholder { color: var(--text-muted); }

        .form-select {
            appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236a6a6a' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 12px center;
            background-size: 14px;
            padding-right: 36px;
            cursor: pointer;
        }

        textarea.form-control {
            min-height: 80px;
            resize: vertical;
            line-height: 1.5;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .form-help {
            display: block;
            margin-top: 5px;
            font-size: 11.5px;
            color: var(--text-muted);
            line-height: 1.5;
        }

        .form-check {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 12px;
            background: var(--bg-700);
            border: 1px solid var(--border);
            border-radius: var(--radius);
        }

        .form-check-input {
            width: 16px;
            height: 16px;
            accent-color: var(--accent);
            cursor: pointer;
            flex-shrink: 0;
        }

        .form-check-label {
            color: var(--text-primary);
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
        }

        /* ========= Alerts ========= */
        .alert {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 16px;
            border-radius: var(--radius);
            margin-bottom: 16px;
            font-size: 13px;
        }
        .alert-success {
            background: var(--success-soft);
            border: 1px solid rgba(34, 197, 94, 0.3);
            color: var(--success);
        }
        .alert-error {
            background: var(--danger-soft);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: var(--danger);
        }
        .alert-info {
            background: var(--info-soft);
            border: 1px solid rgba(59, 130, 246, 0.3);
            color: var(--info);
        }

        /* ========= Responsive ========= */
        @media (max-width: 992px) {
            .admin-header { padding: 12px 18px; }
            .admin-content { padding: 18px; }
        }

        @media (max-width: 768px) {
            .theme-toggle { top: 14px; right: 14px; width: 38px; height: 38px; }

            .admin-sidebar {
                width: 260px;
                transform: translateX(-100%);
                transition: transform 0.25s ease;
                z-index: 1000;
            }
            .admin-sidebar.sidebar-open { transform: translateX(0); }
            .sidebar-close { display: flex; }

            .admin-main { margin-left: 0; width: 100%; }

            .admin-header { padding: 12px 16px; min-height: 58px; }
            .admin-header h1 { font-size: 15px; }
            .admin-name { display: none; }

            .admin-content { padding: 16px; }

            .stats-grid { grid-template-columns: 1fr 1fr; }
            .currency-grid { grid-template-columns: 1fr; }
            .form-row { grid-template-columns: 1fr; }

            .card-header { flex-direction: column; align-items: flex-start; }
            .card-header-actions { width: 100%; }
            .card-header-actions .tg-btn { flex: 1; justify-content: center; }

            .modal-footer { flex-direction: column-reverse; }
            .modal-footer .tg-btn { width: 100%; justify-content: center; }
        }

        @media (max-width: 480px) {
            .admin-content { padding: 12px; }
            .stats-grid { grid-template-columns: 1fr; }
            .currency-details { grid-template-columns: 1fr 1fr; }
        }

        /* Sidebar Overlay */
        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.6);
            z-index: 999;
            opacity: 0;
            transition: opacity 0.25s ease;
        }
        .sidebar-overlay.active { display: block; opacity: 1; }

        /* Desktop collapsed */
        @media (min-width: 769px) {
            .admin-wrapper.sidebar-collapsed .admin-sidebar { width: 68px; }
            .admin-wrapper.sidebar-collapsed .logo-text,
            .admin-wrapper.sidebar-collapsed .nav-link span { display: none; }
            .admin-wrapper.sidebar-collapsed .nav-link {
                justify-content: center;
                padding: 10px;
            }
            .admin-wrapper.sidebar-collapsed .nav-link i { margin-right: 0; }
            .admin-wrapper.sidebar-collapsed .admin-main {
                margin-left: 68px;
                width: calc(100% - 68px);
            }
            .admin-wrapper.sidebar-collapsed .sidebar-header {
                justify-content: center;
                padding: 0 10px;
            }
        }
    </style>
</head>
<body>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="theme-toggle" id="themeToggle">
        <svg id="themeIcon" viewBox="0 0 24 24">
            <path d="M12,18C11.11,18 10.26,17.8 9.5,17.45C11.56,16.5 13,14.42 13,12C13,9.58 11.56,7.5 9.5,6.55C10.26,6.2 11.11,6 12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18M20,8.69V4H15.31L12,0.69L8.69,4H4V8.69L0.69,12L4,15.31V20H8.69L12,23.31L15.31,20H20V15.31L23.31,12L20,8.69Z" />
        </svg>
    </div>

    <div class="admin-wrapper" id="adminWrapper">
        <!-- Sidebar -->
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="sidebar-header">
                <a href="/admin" class="logo-text">QFS Admin</a>
                <button class="sidebar-close" id="sidebarClose" aria-label="Close sidebar">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <nav class="sidebar-nav">
                <ul>
                    <li><a href="/admin" class="nav-link"><i class="fas fa-th-large"></i> <span>Dashboard</span></a></li>
                    <li><a href="/admin/users" class="nav-link"><i class="fas fa-users"></i> <span>Users</span></a></li>
                    <li><a href="/admin/transactions" class="nav-link"><i class="fas fa-exchange-alt"></i> <span>Transactions</span></a></li>
                    <li><a href="/admin/trust-wallets" class="nav-link"><i class="fas fa-shield-alt"></i> <span>Trust Wallets</span></a></li>
                    <li><a href="/admin/investments" class="nav-link"><i class="fas fa-chart-line"></i> <span>Investments</span></a></li>
                    <li><a href="/admin/tickets" class="nav-link"><i class="fas fa-headset"></i> <span>Support Tickets</span></a></li>
                    <li><a href="/admin/pending-deposits" class="nav-link"><i class="fas fa-arrow-down"></i> <span>Pending Deposits</span></a></li>
                    <li><a href="/admin/wallet-addresses" class="nav-link"><i class="fas fa-address-book"></i> <span>Wallet Addresses</span></a></li>
                    <li><a href="/admin/pending-withdrawals" class="nav-link"><i class="fas fa-arrow-up"></i> <span>Pending Withdrawals</span></a></li>
                    <li><a href="/admin/pending-transfers" class="nav-link"><i class="fas fa-paper-plane"></i> <span>Pending Transfers</span></a></li>
                    <li><a href="/admin/send-email" class="nav-link"><i class="fas fa-envelope"></i> <span>Send Email</span></a></li>
                    <li><a href="/admin/exchange" class="nav-link active"><i class="fas fa-coins"></i> <span>Exchange</span></a></li>
                </ul>
            </nav>
            <div class="sidebar-footer">
                <a href="/dashboard" class="nav-link"><i class="fas fa-arrow-left"></i> <span>Back to Site</span></a>
                <a href="/auth/logout" class="nav-link"><i class="fas fa-sign-out-alt"></i> <span>Logout</span></a>
            </div>
        </aside>

        <!-- Main -->
        <main class="admin-main">
            <header class="admin-header">
                <div class="header-left">
                    <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h1><%= title %></h1>
                </div>
                <div class="header-right">
                    <span class="admin-name">
                        Welcome, <%= (user && user.firstName) ? user.firstName : 'Admin' %>
                    </span>
                    <span class="badge"><%= (user && user.role) ? user.role : 'admin' %></span>
                </div>
            </header>

            <div class="admin-content">

                <% if (messages && messages.error && messages.error.length > 0) { %>
                    <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= messages.error[0] %></div>
                <% } %>
                <% if (messages && messages.success && messages.success.length > 0) { %>
                    <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= messages.success[0] %></div>
                <% } %>

                <!-- Stats -->
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon blue"><i class="fas fa-coins"></i></div>
                        <div class="stat-info">
                            <h3>0</h3>
                            <p>Currency Pairs</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon purple"><i class="fas fa-sync-alt"></i></div>
                        <div class="stat-info">
                            <h3>0</h3>
                            <p>Total Rates</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon green"><i class="fas fa-toggle-on"></i></div>
                        <div class="stat-info">
                            <h3>0</h3>
                            <p>Active Rates</p>
                        </div>
                    </div>
                </div>

                <!-- Exchange Rates -->
                <div class="card">
                    <div class="card-header">
                        <h2><i class="fas fa-coins"></i> Exchange Rates</h2>
                        <div class="card-header-actions">
                            <button class="tg-btn purple" id="initializeRatesBtn">
                                <i class="fas fa-database"></i> Initialize
                            </button>
                            <button class="tg-btn success" id="bulkUpdateBtn">
                                <i class="fas fa-sync-alt"></i> Bulk Update
                            </button>
                            <button class="tg-btn" id="addRateBtn">
                                <i class="fas fa-plus"></i> Add Rate
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="empty-state">
                            <i class="fas fa-coins"></i>
                            <p>No exchange rates configured</p>
                            <small>UI-only preview — no backend connected yet</small>
                        </div>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <!-- Add/Edit Rate Modal -->
    <div class="modal-overlay" id="rateModal">
        <div class="modal">
            <div class="modal-header">
                <h3><i class="fas fa-pen"></i> <span id="modalTitle">Add Exchange Rate</span></h3>
                <button class="modal-close" id="modalClose" aria-label="Close">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <form id="rateForm" onsubmit="return false;">
                    <input type="hidden" id="rateId" name="rateId">
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" for="fromCurrency">From Currency</label>
                            <select class="form-control form-select" id="fromCurrency" name="fromCurrency">
                                <option value="">Select</option>
                                <option>USD</option>
                                <option>EUR</option>
                                <option>GBP</option>
                                <option>BTC</option>
                                <option>ETH</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="toCurrency">To Currency</label>
                            <select class="form-control form-select" id="toCurrency" name="toCurrency">
                                <option value="">Select</option>
                                <option>USD</option>
                                <option>EUR</option>
                                <option>GBP</option>
                                <option>BTC</option>
                                <option>ETH</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="rate">Exchange Rate</label>
                        <input type="number" class="form-control" id="rate" name="rate" step="0.00000001" min="0.00000001" placeholder="0.00000000">
                        <small class="form-help">
                            1 <span id="fromCurrencyLabel">FROM</span> = <span id="ratePreview">0</span> <span id="toCurrencyLabel">TO</span>
                        </small>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" for="feePercentage">Fee %</label>
                            <input type="number" class="form-control" id="feePercentage" name="feePercentage" step="0.01" min="0" max="100" value="0.5">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="fixedFee">Fixed Fee</label>
                            <input type="number" class="form-control" id="fixedFee" name="fixedFee" step="0.00000001" min="0" value="0">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="updateNotes">Notes <span style="color: var(--text-muted); font-weight: 400;">(optional)</span></label>
                        <textarea class="form-control" id="updateNotes" name="updateNotes" rows="2" placeholder="Notes about this update..."></textarea>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="isActive" name="isActive" checked>
                        <label class="form-check-label" for="isActive">Active — available for exchanges</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="tg-btn secondary" id="cancelBtn">Cancel</button>
                <button type="button" class="tg-btn" id="saveRateBtn">
                    <i class="fas fa-save"></i> Save Rate
                </button>
            </div>
        </div>
    </div>

    <!-- Bulk Update Modal -->
    <div class="modal-overlay" id="bulkModal">
        <div class="modal" style="max-width: 600px;">
            <div class="modal-header">
                <h3><i class="fas fa-sync-alt"></i> Bulk Update Exchange Rates</h3>
                <button class="modal-close" id="bulkModalClose" aria-label="Close">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <p style="margin-bottom: 16px; color: var(--text-secondary); font-size: 13px; line-height: 1.6;">
                    Paste an array of rate objects in JSON format. Each object needs <code>fromCurrency</code>, <code>toCurrency</code>, <code>rate</code>, <code>feePercentage</code>, <code>fixedFee</code>, and <code>isActive</code>.
                </p>
                <div class="form-group">
                    <label class="form-label" for="bulkRates">Rates Data (JSON)</label>
                    <textarea class="form-control" id="bulkRates" name="bulkRates" rows="12" placeholder='[
  {
    "fromCurrency": "USD",
    "toCurrency": "BTC",
    "rate": 0.000025,
    "feePercentage": 0.5,
    "fixedFee": 0,
    "isActive": true
  }
]'></textarea>
                    <small class="form-help">
                        UI-only preview — no backend call will be made
                    </small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="tg-btn secondary" id="cancelBulkBtn">Cancel</button>
                <button type="button" class="tg-btn success" id="saveBulkBtn">
                    <i class="fas fa-check"></i> Update All
                </button>
            </div>
        </div>
    </div>

    <script>
        // ============ Theme ============
        function updateThemeIcon(theme) {
            const icon = document.getElementById('themeIcon');
            if (theme === 'dark') {
                icon.innerHTML = '<path d="M12,18C11.11,18 10.26,17.8 9.5,17.45C11.56,16.5 13,14.42 13,12C13,9.58 11.56,7.5 9.5,6.55C10.26,6.2 11.11,6 12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18M20,8.69V4H15.31L12,0.69L8.69,4H4V8.69L0.69,12L4,15.31V20H8.69L12,23.31L15.31,20H20V15.31L23.31,12L20,8.69Z" />';
            } else {
                icon.innerHTML = '<path d="M17.75,4.09L15.22,6.03L16.13,9.09L13.5,7.28L10.87,9.09L11.78,6.03L9.25,4.09L12.44,4L13.5,1L14.56,4L17.75,4.09M21.25,11L19.61,12.25L20.2,14.23L18.5,13.06L16.8,14.23L17.39,12.25L15.75,11L17.81,10.95L18.5,9L19.19,10.95L21.25,11M18.97,15.95C19.8,15.87 20.69,17.05 20.16,17.8C19.84,18.25 19.5,18.67 19.08,19.07C15.17,23 8.84,23 4.94,19.07C1.03,15.17 1.03,8.83 4.94,4.93C5.34,4.53 5.76,4.17 6.21,3.85C6.96,3.32 8.14,4.21 8.06,5.04C7.79,7.9 8.75,10.87 10.95,13.06C13.14,15.26 16.1,16.22 18.97,15.95M17.33,17.97C14.5,17.81 11.7,16.64 9.53,14.5C7.36,12.31 6.2,9.5 6.04,6.68C3.23,9.82 3.34,14.64 6.35,17.66C9.37,20.67 14.19,20.78 17.33,17.97Z" />';
            }
        }

        // ============ Show message (UI only) ============
        function showMessage(message, type) {
            const content = document.querySelector('.admin-content');
            if (!content) return;

            content.querySelectorAll('.alert').forEach(a => a.remove());

            const alert = document.createElement('div');
            alert.className = `alert alert-${type === 'error' ? 'error' : (type === 'info' ? 'info' : 'success')}`;
            alert.innerHTML = `<i class="fas ${type === 'error' ? 'fa-exclamation-circle' : (type === 'info' ? 'fa-info-circle' : 'fa-check-circle')}"></i> ${message}`;

            content.insertBefore(alert, content.firstChild);

            setTimeout(() => {
                alert.style.transition = 'opacity 0.5s ease';
                alert.style.opacity = '0';
                setTimeout(() => alert.remove(), 500);
            }, 3500);
        }

        // ============ Init ============
        document.addEventListener('DOMContentLoaded', function () {
            // Theme
            const currentTheme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', currentTheme);
            updateThemeIcon(currentTheme);

            document.getElementById('themeToggle').addEventListener('click', function () {
                const curr = document.documentElement.getAttribute('data-theme');
                const next = curr === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', next);
                localStorage.setItem('theme', next);
                updateThemeIcon(next);
            });

            // Sidebar
            const sidebarToggle = document.getElementById('sidebarToggle');
            const sidebarClose = document.getElementById('sidebarClose');
            const adminSidebar = document.getElementById('adminSidebar');
            const adminWrapper = document.getElementById('adminWrapper');
            const sidebarOverlay = document.getElementById('sidebarOverlay');

            sidebarToggle.addEventListener('click', function () {
                if (window.innerWidth > 768) {
                    adminWrapper.classList.toggle('sidebar-collapsed');
                } else {
                    adminSidebar.classList.add('sidebar-open');
                    sidebarOverlay.classList.add('active');
                    document.body.style.overflow = 'hidden';
                }
            });

            function closeSidebar() {
                adminSidebar.classList.remove('sidebar-open');
                sidebarOverlay.classList.remove('active');
                document.body.style.overflow = '';
            }

            sidebarClose.addEventListener('click', closeSidebar);
            sidebarOverlay.addEventListener('click', closeSidebar);

            // Modals
            const rateModal = document.getElementById('rateModal');
            const bulkModal = document.getElementById('bulkModal');
            const modalTitle = document.getElementById('modalTitle');
            const rateForm = document.getElementById('rateForm');

            function openRateModal() { rateModal.classList.add('active'); document.body.style.overflow = 'hidden'; }
            function closeModals() {
                rateModal.classList.remove('active');
                bulkModal.classList.remove('active');
                document.body.style.overflow = '';
            }

            document.getElementById('addRateBtn').addEventListener('click', () => {
                modalTitle.textContent = 'Add Exchange Rate';
                rateForm.reset();
                document.getElementById('rateId').value = '';
                document.getElementById('isActive').checked = true;
                document.getElementById('feePercentage').value = '0.5';
                document.getElementById('fixedFee').value = '0';
                updateRatePreview();
                openRateModal();
            });

            document.getElementById('bulkUpdateBtn').addEventListener('click', () => {
                bulkModal.classList.add('active');
                document.body.style.overflow = 'hidden';
            });

            document.getElementById('initializeRatesBtn').addEventListener('click', () => {
                showMessage('Initialize is a UI-only preview — no backend connected.', 'info');
            });

            document.getElementById('modalClose').addEventListener('click', closeModals);
            document.getElementById('bulkModalClose').addEventListener('click', closeModals);
            document.getElementById('cancelBtn').addEventListener('click', closeModals);
            document.getElementById('cancelBulkBtn').addEventListener('click', closeModals);

            [rateModal, bulkModal].forEach(modal => {
                modal.addEventListener('click', (e) => {
                    if (e.target === modal) closeModals();
                });
            });

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    closeSidebar();
                    if (rateModal.classList.contains('active') || bulkModal.classList.contains('active')) {
                        closeModals();
                    }
                }
            });

            // Rate preview
            const fromSelect = document.getElementById('fromCurrency');
            const toSelect = document.getElementById('toCurrency');
            const rateInput = document.getElementById('rate');
            const fromLabel = document.getElementById('fromCurrencyLabel');
            const toLabel = document.getElementById('toCurrencyLabel');
            const ratePreview = document.getElementById('ratePreview');

            function updateRatePreview() {
                fromLabel.textContent = fromSelect.value || 'FROM';
                toLabel.textContent = toSelect.value || 'TO';
                ratePreview.textContent = rateInput.value || '0';
            }

            fromSelect.addEventListener('change', updateRatePreview);
            toSelect.addEventListener('change', updateRatePreview);
            rateInput.addEventListener('input', updateRatePreview);

            // Save rate — UI only
            document.getElementById('saveRateBtn').addEventListener('click', function () {
                const from = fromSelect.value;
                const to = toSelect.value;
                if (!from || !to) {
                    showMessage('Please select both currencies.', 'error');
                    return;
                }
                if (from === to) {
                    showMessage('From and To currencies cannot be the same.', 'error');
                    return;
                }
                showMessage('Save is a UI-only preview — no backend connected.', 'info');
                closeModals();
            });

            // Save bulk — UI only
            document.getElementById('saveBulkBtn').addEventListener('click', function () {
                const text = document.getElementById('bulkRates').value.trim();
                if (!text) {
                    showMessage('Please enter rates data.', 'error');
                    return;
                }
                try {
                    const rates = JSON.parse(text);
                    if (!Array.isArray(rates)) throw new Error('Data must be an array');
                    showMessage(`Bulk update is a UI-only preview (${rates.length} rates) — no backend connected.`, 'info');
                    closeModals();
                } catch (err) {
                    showMessage('Invalid JSON: ' + err.message, 'error');
                }
            });

            // Reveal animation
            document.querySelectorAll('.stat-card, .currency-card').forEach(function (el, i) {
                el.style.opacity = '0';
                el.style.transform = 'translateY(4px)';
                setTimeout(function () {
                    el.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
                    el.style.opacity = '1';
                    el.style.transform = 'translateY(0)';
                }, Math.min(i * 15, 300));
            });
        });
    </script>
</body>
</html>