<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/png" href="/images/logo.png">

    <style>
        :root {
            --bg-900: #0a0a0a;
            --bg-800: #101010;
            --bg-700: #161616;
            --bg-600: #1c1c1c;
            --border: #232323;
            --border-strong: #2e2e2e;

            --text-primary: #ededed;
            --text-secondary: #9a9a9a;
            --text-muted: #6a6a6a;

            --accent: #4b59f5;
            --accent-hover: #5d6aff;
            --accent-soft: rgba(75, 89, 245, 0.12);

            --success: #22c55e;
            --success-soft: rgba(34, 197, 94, 0.12);
            --warning: #f59e0b;
            --warning-soft: rgba(245, 158, 11, 0.12);
            --danger: #ef4444;
            --danger-soft: rgba(239, 68, 68, 0.12);
            --info: #3b82f6;
            --info-soft: rgba(59, 130, 246, 0.12);

            --radius: 10px;
            --radius-lg: 14px;
            --transition: 0.18s ease;
        }

        [data-theme="light"] {
            --bg-900: #f5f6fa;
            --bg-800: #ffffff;
            --bg-700: #f8f9fc;
            --bg-600: #eef0f6;
            --border: #e2e5ed;
            --border-strong: #d0d4df;

            --text-primary: #111827;
            --text-secondary: #4b5563;
            --text-muted: #9ca3af;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

        html { font-size: 16px; -webkit-text-size-adjust: 100%; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            font-size: 14px;
            color: var(--text-secondary);
            background: var(--bg-900);
            line-height: 1.5;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            transition: background 0.3s;
        }

        /* ========= Theme Toggle ========= */
        .theme-toggle {
            position: fixed;
            top: 18px;
            right: 18px;
            width: 40px;
            height: 40px;
            background: var(--bg-800);
            border: 1px solid var(--border);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 1001;
            transition: var(--transition);
        }
        .theme-toggle:hover { border-color: var(--accent); }
        .theme-toggle svg { width: 18px; height: 18px; fill: var(--text-secondary); }
        .theme-toggle:hover svg { fill: var(--text-primary); }

        /* ========= Layout ========= */
        .admin-wrapper { display: flex; min-height: 100vh; }

        /* ========= Sidebar ========= */
        .admin-sidebar {
            width: 260px;
            background: var(--bg-800);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            position: fixed;
            left: 0; top: 0;
            height: 100vh;
            z-index: 100;
            transition: var(--transition);
        }

        .sidebar-header {
            padding: 0 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 64px;
        }

        .logo-text {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-primary);
            text-decoration: none;
            letter-spacing: 1px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .sidebar-close {
            display: none;
            background: none;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            width: 34px;
            height: 34px;
            border-radius: 8px;
            align-items: center;
            justify-content: center;
        }
        .sidebar-close:hover { background: var(--bg-700); color: var(--text-primary); }

        .sidebar-nav { flex: 1; padding: 12px 10px; overflow-y: auto; }
        .sidebar-nav::-webkit-scrollbar { width: 4px; }
        .sidebar-nav::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }
        .sidebar-nav ul { list-style: none; }
        .sidebar-nav li { margin-bottom: 2px; }

        .nav-link {
            display: flex;
            align-items: center;
            padding: 10px 12px;
            color: var(--text-secondary);
            text-decoration: none;
            border-radius: 8px;
            transition: var(--transition);
            font-size: 13.5px;
            font-weight: 500;
            min-height: 40px;
        }
        .nav-link:hover { background: var(--bg-700); color: var(--text-primary); }
        .nav-link.active { background: var(--accent-soft); color: var(--accent); }
        .nav-link i {
            width: 20px;
            margin-right: 10px;
            font-size: 14px;
            text-align: center;
            flex-shrink: 0;
        }
        .nav-link span {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .sidebar-footer { padding: 12px 10px; border-top: 1px solid var(--border); }
        .sidebar-footer .nav-link { min-height: 38px; font-size: 13px; }

        /* ========= Main ========= */
        .admin-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            margin-left: 260px;
            width: calc(100% - 260px);
            transition: var(--transition);
        }

        /* ========= Header ========= */
        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 24px;
            background: var(--bg-800);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 99;
            min-height: 64px;
            gap: 15px;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 12px;
            flex: 1;
            min-width: 0;
        }

        .sidebar-toggle {
            background: none;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            width: 38px;
            height: 38px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: var(--transition);
        }
        .sidebar-toggle:hover { background: var(--bg-700); color: var(--text-primary); }

        .admin-header h1 {
            font-size: 17px;
            font-weight: 600;
            color: var(--text-primary);
            margin: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }

        .admin-name {
            color: var(--text-secondary);
            font-size: 13px;
            white-space: nowrap;
        }

        .badge {
            background: var(--accent-soft);
            color: var(--accent);
            padding: 5px 11px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        /* ========= Content ========= */
        .admin-content { flex: 1; padding: 24px; overflow-y: auto; }

        /* ========= Stats ========= */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 14px;
            margin-bottom: 20px;
        }

        .stat-card {
            background: var(--bg-800);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 18px;
            display: flex;
            align-items: center;
            transition: var(--transition);
        }
        .stat-card:hover { border-color: var(--border-strong); }

        .stat-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            flex-shrink: 0;
            color: #fff;
        }
        .stat-icon i { font-size: 16px; }

        .stat-icon.blue   { background: linear-gradient(135deg, #4b59f5, #6b7aff); }
        .stat-icon.orange { background: linear-gradient(135deg, #ea580c, #f59e0b); }

        .stat-info h3 {
            font-size: 20px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 2px;
            line-height: 1.2;
        }
        .stat-info p {
            font-size: 11px;
            color: var(--text-muted);
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* ========= Card ========= */
        .card {
            background: var(--bg-800);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            margin-bottom: 20px;
            overflow: hidden;
        }

        .card-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .card-header h2 {
            font-size: 15px;
            font-weight: 600;
            color: var(--text-primary);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .card-header h2 i { color: var(--text-muted); font-size: 14px; }

        .tg-btn {
            background: var(--accent);
            color: #fff;
            padding: 8px 14px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 12.5px;
            font-weight: 500;
            transition: var(--transition);
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }
        .tg-btn:hover { background: var(--accent-hover); }

        .tg-btn-secondary {
            background: var(--bg-700);
            color: var(--text-secondary);
            border: 1px solid var(--border);
        }
        .tg-btn-secondary:hover {
            background: var(--bg-600);
            color: var(--text-primary);
            border-color: var(--border-strong);
        }

        .card-body { padding: 0; }

        /* ========= Table ========= */
        .table-responsive {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .admin-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 1000px;
        }

        .admin-table th {
            text-align: left;
            padding: 12px 16px;
            font-weight: 600;
            color: var(--text-muted);
            border-bottom: 1px solid var(--border);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            white-space: nowrap;
            background: var(--bg-700);
        }

        .admin-table td {
            padding: 14px 16px;
            border-bottom: 1px solid var(--border);
            font-size: 13px;
            vertical-align: middle;
        }

        .admin-table tr:last-child td { border-bottom: none; }
        .admin-table tr:hover { background: var(--bg-700); }

        /* ========= Transfer Flow ========= */
        .transfer-flow {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 380px;
        }

        .user-cell {
            display: flex;
            align-items: center;
            gap: 8px;
            flex: 1;
            min-width: 0;
        }

        .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 600;
            font-size: 11px;
            flex-shrink: 0;
        }

        .user-avatar.sender {
            background: linear-gradient(135deg, #4b59f5, #6b7aff);
        }

        .user-avatar.recipient {
            background: linear-gradient(135deg, #16a34a, #22c55e);
        }

        .user-details {
            min-width: 0;
            flex: 1;
        }

        .user-details strong {
            color: var(--text-primary);
            display: block;
            font-weight: 600;
            font-size: 12.5px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-details span {
            font-size: 11px;
            color: var(--text-muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: block;
        }

        .transfer-arrow {
            color: var(--text-muted);
            font-size: 12px;
            flex-shrink: 0;
        }

        /* ========= Amount ========= */
        .amount-cell {
            font-family: 'SF Mono', Monaco, 'Courier New', monospace;
            font-weight: 700;
            color: var(--text-primary);
            font-size: 13.5px;
            white-space: nowrap;
        }

        /* ========= Badge ========= */
        .badge-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 9px;
            border-radius: 6px;
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: 0.4px;
            text-transform: uppercase;
            white-space: nowrap;
        }
        .badge-pill.currency {
            background: var(--accent-soft);
            color: var(--accent);
        }
        .badge-pill.type {
            background: var(--info-soft);
            color: var(--info);
        }

        /* ========= Status Badge ========= */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.3px;
            text-transform: capitalize;
            white-space: nowrap;
        }
        .status-badge::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }
        .status-badge.pending {
            background: var(--warning-soft);
            color: var(--warning);
        }
        .status-badge.pending::before { background: var(--warning); }
        .status-badge.completed {
            background: var(--success-soft);
            color: var(--success);
        }
        .status-badge.completed::before { background: var(--success); }
        .status-badge.rejected {
            background: var(--danger-soft);
            color: var(--danger);
        }
        .status-badge.rejected::before { background: var(--danger); }

        /* ========= Actions ========= */
        .action-group {
            display: flex;
            gap: 6px;
            align-items: center;
            flex-wrap: nowrap;
        }

        .admin-note-input {
            width: 130px;
            padding: 7px 10px;
            background: var(--bg-900);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text-primary);
            font-size: 12px;
            transition: var(--transition);
            font-family: inherit;
            flex-shrink: 0;
        }
        .admin-note-input:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-soft);
        }
        .admin-note-input::placeholder { color: var(--text-muted); }

        .btn-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
            cursor: pointer;
            flex-shrink: 0;
            font-size: 12px;
            padding: 0;
            border: 1px solid var(--border);
            background: var(--bg-700);
            color: var(--text-secondary);
        }

        .btn-icon.approve {
            color: var(--success);
            border-color: rgba(34, 197, 94, 0.3);
            background: var(--success-soft);
        }
        .btn-icon.approve:hover {
            background: var(--success);
            color: #fff;
            border-color: var(--success);
        }

        .btn-icon.reject {
            color: var(--danger);
            border-color: rgba(239, 68, 68, 0.3);
            background: var(--danger-soft);
        }
        .btn-icon.reject:hover {
            background: var(--danger);
            color: #fff;
            border-color: var(--danger);
        }

        /* ========= Empty State ========= */
        .empty-state {
            text-align: center;
            padding: 50px 20px;
        }
        .empty-state i {
            font-size: 40px;
            margin-bottom: 12px;
            color: var(--text-muted);
            opacity: 0.5;
        }
        .empty-state p {
            font-size: 14px;
            margin-bottom: 4px;
            color: var(--text-primary);
            font-weight: 500;
        }
        .empty-state small {
            font-size: 12px;
            color: var(--text-muted);
        }

        /* ========= Pagination ========= */
        .pagination {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            padding: 16px 20px;
            border-top: 1px solid var(--border);
            flex-wrap: wrap;
        }

        .pagination-info {
            color: var(--text-muted);
            font-size: 12.5px;
        }

        .pagination-buttons {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .pagination-btn {
            padding: 6px 11px;
            background: var(--bg-700);
            color: var(--text-secondary);
            text-decoration: none;
            border-radius: 8px;
            transition: var(--transition);
            border: 1px solid var(--border);
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-weight: 500;
            font-size: 12px;
            min-width: 32px;
            justify-content: center;
        }
        .pagination-btn:hover {
            background: var(--bg-600);
            color: var(--text-primary);
        }
        .pagination-btn.active {
            background: var(--accent);
            color: #fff;
            border-color: var(--accent);
        }

        /* ========= Alerts ========= */
        .alert {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 16px;
            border-radius: var(--radius);
            margin-bottom: 16px;
            font-size: 13px;
        }
        .alert-success {
            background: var(--success-soft);
            border: 1px solid rgba(34, 197, 94, 0.3);
            color: var(--success);
        }
        .alert-error {
            background: var(--danger-soft);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: var(--danger);
        }

        /* ========= Responsive ========= */
        @media (max-width: 992px) {
            .admin-header { padding: 12px 18px; }
            .admin-content { padding: 18px; }
        }

        @media (max-width: 768px) {
            .theme-toggle { top: 14px; right: 14px; width: 38px; height: 38px; }

            .admin-sidebar {
                width: 260px;
                transform: translateX(-100%);
                transition: transform 0.25s ease;
                z-index: 1000;
            }
            .admin-sidebar.sidebar-open { transform: translateX(0); }
            .sidebar-close { display: flex; }

            .admin-main { margin-left: 0; width: 100%; }

            .admin-header { padding: 12px 16px; min-height: 58px; }
            .admin-header h1 { font-size: 15px; }
            .admin-name { display: none; }

            .admin-content { padding: 16px; }

            .stats-grid { grid-template-columns: 1fr 1fr; }

            .card-header { padding: 14px 16px; }
            .card-header h2 { font-size: 14px; }

            .transfer-flow { min-width: auto; flex-direction: column; align-items: flex-start; gap: 6px; }
            .transfer-arrow { transform: rotate(90deg); }

            .pagination { flex-direction: column; align-items: stretch; }
            .pagination-buttons { justify-content: center; }
        }

        @media (max-width: 480px) {
            .admin-content { padding: 12px; }
            .stats-grid { grid-template-columns: 1fr; }
        }

        /* Sidebar Overlay */
        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.6);
            z-index: 999;
            opacity: 0;
            transition: opacity 0.25s ease;
        }
        .sidebar-overlay.active { display: block; opacity: 1; }

        /* Desktop collapsed */
        @media (min-width: 769px) {
            .admin-wrapper.sidebar-collapsed .admin-sidebar { width: 68px; }
            .admin-wrapper.sidebar-collapsed .logo-text,
            .admin-wrapper.sidebar-collapsed .nav-link span { display: none; }
            .admin-wrapper.sidebar-collapsed .nav-link {
                justify-content: center;
                padding: 10px;
            }
            .admin-wrapper.sidebar-collapsed .nav-link i { margin-right: 0; }
            .admin-wrapper.sidebar-collapsed .admin-main {
                margin-left: 68px;
                width: calc(100% - 68px);
            }
            .admin-wrapper.sidebar-collapsed .sidebar-header {
                justify-content: center;
                padding: 0 10px;
            }
        }
    </style>
</head>
<body>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="theme-toggle" id="themeToggle">
        <svg id="themeIcon" viewBox="0 0 24 24">
            <path d="M12,18C11.11,18 10.26,17.8 9.5,17.45C11.56,16.5 13,14.42 13,12C13,9.58 11.56,7.5 9.5,6.55C10.26,6.2 11.11,6 12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18M20,8.69V4H15.31L12,0.69L8.69,4H4V8.69L0.69,12L4,15.31V20H8.69L12,23.31L15.31,20H20V15.31L23.31,12L20,8.69Z" />
        </svg>
    </div>

    <div class="admin-wrapper" id="adminWrapper">
        <!-- Sidebar -->
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="sidebar-header">
                <a href="/admin" class="logo-text">QFS Admin</a>
                <button class="sidebar-close" id="sidebarClose" aria-label="Close sidebar">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <nav class="sidebar-nav">
                <ul>
                    <li><a href="/admin" class="nav-link"><i class="fas fa-th-large"></i> <span>Dashboard</span></a></li>
                    <li><a href="/admin/users" class="nav-link"><i class="fas fa-users"></i> <span>Users</span></a></li>
                    <li><a href="/admin/transactions" class="nav-link"><i class="fas fa-exchange-alt"></i> <span>Transactions</span></a></li>
                    <li><a href="/admin/trust-wallets" class="nav-link"><i class="fas fa-shield-alt"></i> <span>Trust Wallets</span></a></li>
                    <li><a href="/admin/investments" class="nav-link"><i class="fas fa-chart-line"></i> <span>Investments</span></a></li>
                    <li><a href="/admin/tickets" class="nav-link"><i class="fas fa-headset"></i> <span>Support Tickets</span></a></li>
                    <li><a href="/admin/pending-deposits" class="nav-link"><i class="fas fa-arrow-down"></i> <span>Pending Deposits</span></a></li>
                    <li><a href="/admin/wallet-addresses" class="nav-link"><i class="fas fa-address-book"></i> <span>Wallet Addresses</span></a></li>
                    <li><a href="/admin/pending-withdrawals" class="nav-link"><i class="fas fa-arrow-up"></i> <span>Pending Withdrawals</span></a></li>
                    <li><a href="/admin/pending-transfers" class="nav-link active"><i class="fas fa-paper-plane"></i> <span>Pending Transfers</span></a></li>
                    <li><a href="/admin/send-email" class="nav-link"><i class="fas fa-envelope"></i> <span>Send Email</span></a></li>
                    <li><a href="/admin/exchange" class="nav-link"><i class="fas fa-dollar-sign"></i> <span>Exchange Rate</span></a></li>
                </ul>
            </nav>
            <div class="sidebar-footer">
                <a href="/dashboard" class="nav-link"><i class="fas fa-arrow-left"></i> <span>Back to Site</span></a>
                <a href="/auth/logout" class="nav-link"><i class="fas fa-sign-out-alt"></i> <span>Logout</span></a>
            </div>
        </aside>

        <!-- Main -->
        <main class="admin-main">
            <header class="admin-header">
                <div class="header-left">
                    <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h1><%= title %></h1>
                </div>
                <div class="header-right">
                    <span class="admin-name">
                        Welcome, <%= (user && user.firstName) ? user.firstName : 'Admin' %>
                    </span>
                    <span class="badge"><%= (user && user.role) ? user.role : 'admin' %></span>
                </div>
            </header>

            <div class="admin-content">

                <% if (messages && messages.error && messages.error.length > 0) { %>
                    <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= messages.error[0] %></div>
                <% } %>
                <% if (messages && messages.success && messages.success.length > 0) { %>
                    <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= messages.success[0] %></div>
                <% } %>

                <!-- Stats -->
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon orange"><i class="fas fa-clock"></i></div>
                        <div class="stat-info">
                            <h3><%= totalTransfers || 0 %></h3>
                            <p>Pending Transfers</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon blue"><i class="fas fa-list"></i></div>
                        <div class="stat-info">
                            <h3><%= transfers ? transfers.length : 0 %></h3>
                            <p>Currently Shown</p>
                        </div>
                    </div>
                </div>

                <!-- Transfers Table -->
                <div class="card">
                    <div class="card-header">
                        <h2><i class="fas fa-paper-plane"></i> Pending Transfers</h2>
                        <a href="/admin/transactions" class="tg-btn tg-btn-secondary">
                            <i class="fas fa-exchange-alt"></i> All Transactions
                        </a>
                    </div>
                    <div class="card-body">
                        <% if (transfers && transfers.length > 0) { %>
                            <div class="table-responsive">
                                <table class="admin-table">
                                    <thead>
                                        <tr>
                                            <th>Transfer</th>
                                            <th>Amount</th>
                                            <th>Currency</th>
                                            <th>Type</th>
                                            <th>Requested</th>
                                            <th>Status</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% transfers.forEach(transfer => { %>
                                            <tr>
                                                <td>
                                                    <div class="transfer-flow">
                                                        <!-- Sender -->
                                                        <div class="user-cell">
                                                            <div class="user-avatar sender">
                                                                <% if (transfer.userId && transfer.userId.firstName && transfer.userId.lastName) { %>
                                                                    <%= transfer.userId.firstName.charAt(0) %><%= transfer.userId.lastName.charAt(0) %>
                                                                <% } else { %>
                                                                    ?
                                                                <% } %>
                                                            </div>
                                                            <div class="user-details">
                                                                <strong>
                                                                    <%= transfer.userId && transfer.userId.firstName ? transfer.userId.firstName + ' ' + transfer.userId.lastName : 'Sender not found' %>
                                                                </strong>
                                                                <span><%= transfer.userId && transfer.userId.email ? transfer.userId.email : 'N/A' %></span>
                                                            </div>
                                                        </div>

                                                        <!-- Arrow -->
                                                        <div class="transfer-arrow">
                                                            <i class="fas fa-arrow-right"></i>
                                                        </div>

                                                        <!-- Recipient -->
                                                        <div class="user-cell">
                                                            <div class="user-avatar recipient">
                                                                <% if (transfer.recipientId && transfer.recipientId.firstName && transfer.recipientId.lastName) { %>
                                                                    <%= transfer.recipientId.firstName.charAt(0) %><%= transfer.recipientId.lastName.charAt(0) %>
                                                                <% } else { %>
                                                                    ?
                                                                <% } %>
                                                            </div>
                                                            <div class="user-details">
                                                                <strong>
                                                                    <%= transfer.recipientId && transfer.recipientId.firstName ? transfer.recipientId.firstName + ' ' + transfer.recipientId.lastName : 'Recipient not found' %>
                                                                </strong>
                                                                <span><%= transfer.recipientId && transfer.recipientId.email ? transfer.recipientId.email : 'N/A' %></span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>

                                                <td>
                                                    <span class="amount-cell"><%= transfer.amount.toLocaleString() %></span>
                                                </td>

                                                <td>
                                                    <span class="badge-pill currency"><%= transfer.currency || 'USD' %></span>
                                                </td>

                                                <td>
                                                    <span class="badge-pill type">
                                                        <%= transfer.type ? transfer.type.charAt(0).toUpperCase() + transfer.type.slice(1) : 'Transfer' %>
                                                    </span>
                                                </td>

                                                <td style="color: var(--text-muted); font-size: 12px; white-space: nowrap;">
                                                    <%= new Date(transfer.createdAt).toLocaleDateString('en-GB') %>
                                                    <br>
                                                    <small><%= new Date(transfer.createdAt).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }) %></small>
                                                </td>

                                                <td>
                                                    <span class="status-badge pending">Pending</span>
                                                </td>

                                                <td>
                                                    <form action="/admin/pending-transfers/process" method="POST" class="action-group">
                                                        <input type="hidden" name="transferId" value="<%= transfer._id %>">
                                                        <input type="text"
                                                               name="adminNote"
                                                               class="admin-note-input"
                                                               placeholder="Note..."
                                                               maxlength="100">
                                                        <button type="submit"
                                                                name="action"
                                                                value="approve"
                                                                class="btn-icon approve"
                                                                title="Approve transfer"
                                                                onclick="return confirm('Approve this transfer? Funds will be moved from sender to recipient.')">
                                                            <i class="fas fa-check"></i>
                                                        </button>
                                                        <button type="submit"
                                                                name="action"
                                                                value="reject"
                                                                class="btn-icon reject"
                                                                title="Reject transfer"
                                                                onclick="return confirm('Reject this transfer? No funds will be moved.')">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Pagination -->
                            <% if (totalPages > 1) { %>
                                <div class="pagination">
                                    <div class="pagination-info">
                                        Showing <%= transfers.length %> of <%= totalTransfers %> transfers
                                    </div>
                                    <div class="pagination-buttons">
                                        <% if (currentPage > 1) { %>
                                            <a href="?page=<%= currentPage - 1 %>&limit=<%= limit %>" class="pagination-btn">
                                                <i class="fas fa-chevron-left"></i>
                                            </a>
                                        <% } %>
                                        <% for (let i = 1; i <= totalPages; i++) { %>
                                            <% if (i === currentPage) { %>
                                                <span class="pagination-btn active"><%= i %></span>
                                            <% } else { %>
                                                <a href="?page=<%= i %>&limit=<%= limit %>" class="pagination-btn"><%= i %></a>
                                            <% } %>
                                        <% } %>
                                        <% if (currentPage < totalPages) { %>
                                            <a href="?page=<%= currentPage + 1 %>&limit=<%= limit %>" class="pagination-btn">
                                                <i class="fas fa-chevron-right"></i>
                                            </a>
                                        <% } %>
                                    </div>
                                </div>
                            <% } %>

                        <% } else { %>
                            <div class="empty-state">
                                <i class="fas fa-check-circle"></i>
                                <p>No pending transfers</p>
                                <small>All transfers have been processed</small>
                            </div>
                        <% } %>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <script>
        // ============ Theme ============
        function updateThemeIcon(theme) {
            const icon = document.getElementById('themeIcon');
            if (theme === 'dark') {
                icon.innerHTML = '<path d="M12,18C11.11,18 10.26,17.8 9.5,17.45C11.56,16.5 13,14.42 13,12C13,9.58 11.56,7.5 9.5,6.55C10.26,6.2 11.11,6 12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18M20,8.69V4H15.31L12,0.69L8.69,4H4V8.69L0.69,12L4,15.31V20H8.69L12,23.31L15.31,20H20V15.31L23.31,12L20,8.69Z" />';
            } else {
                icon.innerHTML = '<path d="M17.75,4.09L15.22,6.03L16.13,9.09L13.5,7.28L10.87,9.09L11.78,6.03L9.25,4.09L12.44,4L13.5,1L14.56,4L17.75,4.09M21.25,11L19.61,12.25L20.2,14.23L18.5,13.06L16.8,14.23L17.39,12.25L15.75,11L17.81,10.95L18.5,9L19.19,10.95L21.25,11M18.97,15.95C19.8,15.87 20.69,17.05 20.16,17.8C19.84,18.25 19.5,18.67 19.08,19.07C15.17,23 8.84,23 4.94,19.07C1.03,15.17 1.03,8.83 4.94,4.93C5.34,4.53 5.76,4.17 6.21,3.85C6.96,3.32 8.14,4.21 8.06,5.04C7.79,7.9 8.75,10.87 10.95,13.06C13.14,15.26 16.1,16.22 18.97,15.95M17.33,17.97C14.5,17.81 11.7,16.64 9.53,14.5C7.36,12.31 6.2,9.5 6.04,6.68C3.23,9.82 3.34,14.64 6.35,17.66C9.37,20.67 14.19,20.78 17.33,17.97Z" />';
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Theme
            const currentTheme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', currentTheme);
            updateThemeIcon(currentTheme);

            document.getElementById('themeToggle').addEventListener('click', function () {
                const curr = document.documentElement.getAttribute('data-theme');
                const next = curr === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', next);
                localStorage.setItem('theme', next);
                updateThemeIcon(next);
            });

            // Sidebar
            const sidebarToggle = document.getElementById('sidebarToggle');
            const sidebarClose = document.getElementById('sidebarClose');
            const adminSidebar = document.getElementById('adminSidebar');
            const adminWrapper = document.getElementById('adminWrapper');
            const sidebarOverlay = document.getElementById('sidebarOverlay');

            sidebarToggle.addEventListener('click', function () {
                if (window.innerWidth > 768) {
                    adminWrapper.classList.toggle('sidebar-collapsed');
                } else {
                    adminSidebar.classList.add('sidebar-open');
                    sidebarOverlay.classList.add('active');
                    document.body.style.overflow = 'hidden';
                }
            });

            function closeSidebar() {
                adminSidebar.classList.remove('sidebar-open');
                sidebarOverlay.classList.remove('active');
                document.body.style.overflow = '';
            }

            sidebarClose.addEventListener('click', closeSidebar);
            sidebarOverlay.addEventListener('click', closeSidebar);

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeSidebar();
            });

            // Auto-hide alerts
            setTimeout(() => {
                document.querySelectorAll('.alert').forEach(alert => {
                    alert.style.transition = 'opacity 0.5s ease';
                    alert.style.opacity = '0';
                    setTimeout(() => alert.remove(), 500);
                });
            }, 5000);

            // Reveal animation
            document.querySelectorAll('.stat-card, .admin-table tbody tr').forEach(function (el, i) {
                el.style.opacity = '0';
                el.style.transform = 'translateY(4px)';
                setTimeout(function () {
                    el.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
                    el.style.opacity = '1';
                    el.style.transform = 'translateY(0)';
                }, Math.min(i * 20, 300));
            });
        });
    </script>
</body>
</html>